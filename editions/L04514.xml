   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0342"/>Hrn <hi rend="latintype">Gustav Schwarzkopf</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">Wien I</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207301">
                     <hi rend="latintype">Tiefer Graben 17</hi>
                  </rs>
               </addrLine>
            </address>
         </div>
         <div type="image">
            <p>
               <pb facs="HS00048772X_0341"/>
               <hi rend="pre-print">3005 <rs type="place" ref="#pmb353736">Ober-Engadin</rs> – <rs type="place" ref="#pmb34108">Maloja</rs> (1811 m) – <rs type="place" ref="#pmb55166">Kursaal</rs> mit <rs type="place" ref="#pmb254922">Silsersee</rs> (1800 m)</hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="center"><pb facs="HS00048772X_0342"/>
                  <rs type="place" ref="#pmb91199">Maloja</rs>
                  <space unit="chars" quantity="1"/>
                  <date>27/8 913</date>
               </dateline>
            </opener>
            <p>Bitten um ein Wort nach <hi rend="latintype">
                  <rs type="place" ref="#pmb44374">St. Moriz</rs>
               </hi> (<rs type="place" ref="#pmb254904">Grd <hi rend="latintype">Hotel</hi>
               </rs>) wo wir wohnen und uns bei ſchönſtem Wetter vortrefflich <pb facs="HS00048772X_0341"/>befinden! Ihr
               <signed>A.</signed>
            </p>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb2173"/>Herzlichst Ihre <signed>OlgaS.</signed>
            </p>
         </div>
      </body>
