   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <hi rend="latintype">
                     <pb facs="MS-SCHNITZLER-B-00043-B-00001-000-00210"/>Herrn D<hi rend="superscript">r</hi> Arthur Schnitzler</hi>
               </addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs ref="#pmb50" type="place">Wien</rs>
                  </hi>
               </addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs ref="#pmb168934" type="place">XI. Franckgasse 1.</rs>
                  </hi>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="MS-SCHNITZLER-B-00043-B-00001-000-00209"/>
                  <date>12<hi rend="superscript">ten</hi>
                  </date>
               </dateline>
               <salute>Mein lieber Arthur</salute>
            </opener>
            <p>ich bin von morgen <date>Mittwoch</date>
               <space unit="chars" quantity="1"/>
               <time>abend</time> an in <rs ref="#pmb50" type="place">Wien</rs>. Falls Sie ſich zu
               einer <anchor type="commentary" xml:id="K_L00731-1"/>
               <rs ref="#pmb11851" type="person">Kainz</rs>vorſtellung, <rs type="work" ref="#pmb34284" subtype="implied">
                  <rs type="event" ref="#pmb208965" subtype="implied">
                     <date>Donnerstag</date>
                  </rs>
               </rs>
               <note type="commentary" corresp="K_L00731-1">
                  <ref type="schnitzler-kultur" target="pmb208965"/>.</note> oder <anchor type="commentary" xml:id="K_L00731-2"/>
               <date>Freitag</date>
               <note type="commentary" corresp="K_L00731-2">Am Freitag, dem <ref type="schnitzler-kultur" subtype="date-only" target="pmb208966"/> besuchte <rs type="person" ref="#pmb2121">Schnitzler</rs> eine <rs type="event" ref="#pmb208966">Aufführung von <rs type="work" ref="#pmb195824">Japhet und
                        seine zwölf Frauen</rs> im <rs type="place" ref="#pmb40">Theater in der
                        Josefstadt</rs></rs>.</note> einen Sitz nehmen und noch Zeit haben, einen
               gleichen für mich zu nehmen bitte thuen Sie es und ſchreiben mir vielleicht eine
               Zeile wo ich Sie für’s Theater abholen kann.</p>
            <closer>Ihr<signed>Hugo.</signed>
            </closer>
         </div>
      </body>
