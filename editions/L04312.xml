   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00096-A-000-00151"/>Herrn
                  <hi rend="latintype">D<hi rend="superscript">r</hi> Arthur Schnitzler</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb68">Wien, XVIII. Währing</rs>.</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb168940">Spöttelgaſſe 7</rs>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <salute>
                  <pb facs="MS-SCHNITZLER-B-00096-A-000-00152"/>Sehr geehrter Freund!</salute>
            </opener>
            <p>
               <anchor type="commentary" xml:id="K_L04312-1"/>
               <rs type="work" ref="#pmb300273">der reine Tor</rs> hat, wie ich glaube,
               Ihnen keine Schande<note type="commentary" corresp="K_L04312-1">
                  Die <rs type="event" ref="#pmb333620">Uraufführung von <rs type="work" ref="#pmb300273">Der reine Tor</rs>
                  </rs> hatte am <date when="1904-06-17">17. 6. 1904</date> am <rs type="org" ref="#pmb37080">Neues Deutsches Theater</rs> in <rs type="place" ref="#pmb652">Prag</rs> stattgefunden.
               </note> gemacht.</p>
            <closer>Es grüßt Sie und Ihre <rs type="person" ref="#pmb2173" subtype="implied">Frau</rs> vielmals<lb/>Ihr ergebener<lb/>
               <signed>D<hi rend="superscript">r</hi> M Schwarzkopf</signed>
            </closer>
            <postscript>
               <dateline rend="right">
                  <date>18/VI 04</date>.</dateline>
            </postscript>
         </div>
      </body>
