      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00096-A-000-00065"/>
                  <rs type="place" ref="#pmb207296">I. Tiefer Graben 23</rs>.</addrLine>
