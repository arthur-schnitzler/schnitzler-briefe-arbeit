            <p rend="center">
               <pb facs="MS-B-00005-B-000-00108"/>
               <hi rend="pre-print">Hermann Bahr</hi></p>
            <p>dankt Dir, lieber Freund, herzlichſt für Dein <anchor type="commentary" xml:id="K_L01032-1"/>
               <rs type="work" ref="#pmb29855" subtype="implied">Buch</rs>
               <note type="commentary" corresp="K_L01032-1">
                  <bibl>
                     <rs ref="#pmb2121" type="person">Arthur Schnitzler</rs>: <rs ref="#pmb29855" type="work">Reigen. Zehn Dialoge</rs>. <date>Winter
                        1896</date>/<date>97</date> [Privatdruck, 200 Exemplare,
                     <date>1900</date>]</bibl>.</note>: Die <rs ref="#pmb12618" type="person">Sandrock</rs> iſt <pb facs="MS-B-00005-B-000-00109"/>einfach famos!</p>
            <closer>In alter Freundſchaft<lb/>
               <signed>HermannBahr</signed>
            </closer>
            <postscript>
               <dateline>
                  <date>20/4</date>
               </dateline>
            </postscript>
         </div>
