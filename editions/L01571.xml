                     <rs ref="#pmb2693" type="person" subtype="implied">Sophokles</rs>
                  </hi>.</addrLine>
            </address>
            <address>
               <addrLine>
                  <hi rend="latintype">Herrn D<hi rend="superscript">r</hi> Arthur Schnitzler</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">
                     <hi rend="latintype">Wien</hi>
                  </rs>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb168940" type="place">
                     <hi rend="latintype">XVIII. Spöttelgasse 7</hi>.</rs>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00043-B-00002-000-00226" />
               <salute>lieber,</salute> bitte
               ſchreiben Sie mir doch 2 Worte über das <anchor type="commentary" xml:id="K_L01571-1" />
               <rs type="work" subtype="implied" ref="#pmb43898">Stück</rs>
               <note type="commentary" corresp="K_L01571-1">
                  <rs type="work" ref="#pmb43898">Der Jäger</rs> blieb in dieser Gestalt
                  unveröffentlicht und wurde, zur Novelle umgearbeitet, <date>1912</date>
                  publiziert.</note> von <rs ref="#pmb12254" type="person">Michel</rs>, ſchicken es
               aber bitte nicht an mich zurück ſondern gleich an ihn: </p>
            <p>
               <hi rend="latintype">Oberleutnant <rs ref="#pmb12254" type="person">Robert
                     Michel</rs>
               </hi>
            </p>
            <p>
               <rs ref="#pmb867" type="place">
                  <hi rend="latintype">Innsbruck</hi>
               </rs>
            </p>
            <p>
               <hi rend="latintype">Infanterie Cadettenschule.</hi>
            </p>
            <closer>
               <signed>Hugo.</signed>
            </closer>
            <postscript>
               <p>
                  <date>2 I.</date>
               </p>
            </postscript>
         </div>
