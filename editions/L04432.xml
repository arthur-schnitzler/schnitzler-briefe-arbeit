      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0170"/>Herrn Gustav Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">Wien</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296">I. Tiefer Graben 23</rs>.</addrLine>
            </address>
         </div>
         <div type="image">
            <seg rend="center">
               <pb facs="HS00048772X_0169"/>
               <hi rend="pre-print">Gruss aus <rs type="place" ref="#pmb18135">Bad Kreuth</rs>!</hi>
            </seg>
         </div>
         <div type="writingSession" n="1">
            <p><pb facs="HS00048772X_0169"/>Sind Sie ſchon in <rs type="place" ref="#pmb50">Wien</rs>? – <rs type="place" ref="#pmb39752">Tegernſee</rs> iſt wirklich »lieblich«,  die Radwege u
                  Au<unclear>s</unclear>flüge glänzend, <rs type="place" ref="#pmb64703">Kreuth</rs>
               überraſchend ſchön</p>
            <p>Ich bitt um event. Nachricht ins <rs type="place" ref="#pmb34048">Hotel Post</rs>.</p>
            <closer>Von Herzen<lb/>Ihr <signed>Arthur</signed>
            </closer>
         </div>
      </body>
