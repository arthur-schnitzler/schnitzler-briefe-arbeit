      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00089-A-00002-000-00012-V"/>Herrn D<hi rend="superscript">r</hi> Arthur Schnitzler</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">
                     <del rend="strikethrough">Wien</del>
                  </rs>
