         <div type="image">
            <p rend="center">
               <pb facs="HS.NZ85.1.3175_0066"/>
               <supplied type="image-description">Schuppen zwischen Bäumen</supplied>
            </p>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="left">
                  <pb facs="HS.NZ85.1.3175_0065"/>
                  <date when="1908-08-09">9. 8. 08</date>.</dateline>
               <salute rend="left">Lieber Freund,</salute>
            </opener>
            <p>Meine <rs type="person" subtype="implied" ref="#pmb17164">Frau</rs> u. ich danken
               Euch herzlich für Eure <anchor type="commentary" xml:id="K_L03464-1"/>Glückwünſche<note type="commentary" corresp="K_L03464-1">
                  <ref type="schnitzler-briefe" target="L03463" subtype="See"/>.
               </note>.</p>
            <p>
               <rs type="person" subtype="implied" ref="#pmb17164">Wir</rs> reiſen morgen nach <rs type="place" ref="#pmb772">Marienbad</rs>, <rs type="place" ref="#pmb147567">Haus
                     <hi rend="latintype">Palladio</hi>
               </rs>. Ich würde mich ſehr freuen, dorthin von Dir eine Karte zu bekommen.</p>
            <closer>Mit herzlichen Grüßen von meiner <rs type="person" subtype="implied" ref="#pmb17164">Frau</rs> u. mir <lb/>Dein <lb/>
               <signed>Paul Goldmann.</signed>
            </closer>
         </div>
      </body>
