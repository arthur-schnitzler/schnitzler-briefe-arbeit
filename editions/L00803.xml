      <body>
         <div type="address">
            <address>
               <addrLine>
                  <hi rend="latintype">
                     <pb facs="1898_AS_RBH_2_00016"/>Dr. Richard Beer-Hofmann</hi></addrLine>
               <addrLine>
                  <hi rend="latintype">
