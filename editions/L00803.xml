               <addrLine>
                  <hi rend="latintype">am <rs ref="#pmb40374" type="place">Ossiacher See</rs></hi></addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs ref="#pmb651" type="place">Kärnthen</rs></hi></addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="1898_AS_RBH_2_00017"/>
               <hi rend="pre-print">Gruss aus <rs ref="#pmb36189" type="place">Krieglach</rs>. <rs type="person" ref="#pmb12551">P. K. Rosegger</rs>’s
                  Geburtshaus. <rs type="person" ref="#pmb12551">P. K. Rosegger</rs>’s Villa</hi></p>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="1898_AS_RBH_2_00017"/>
                  <date when="1898-06-05">So<c rendition="#gemination-n"/>tag</date>.</dateline>
            </opener>
            <p>Hier iſt das erſte Nachtquartier. I<c rendition="#gemination-m"/>er näher. Herzlichſt
               Ihr <signed>Arth</signed></p>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb11981"/>D<hi rend="superscript">r</hi> Schnitzler maltraitirt
               mich schrecklich</p>
            <p>Ich komme luftleer nach <rs ref="#pmb40376" type="place">Ossiach</rs> –
                  <signed>Kramer</signed></p>
         </div>
