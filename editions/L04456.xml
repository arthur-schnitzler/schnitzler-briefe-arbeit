   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0220"/>
                  <hi rend="latintype">Herrn Gustav Schwarzkopf</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">Wien I</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207301">
                     <hi rend="latintype">Tiefer Graben 17</hi>
                  </rs>
               </addrLine>
            </address>
         </div>
         <div type="image">
            <p>
               <pb facs="HS00048772X_0219"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb52262">Starnberger See</rs>: <rs type="place" ref="#pmb51937">Tutzing mit Hôtel Simson</rs>
               </hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="HS00048772X_0220"/>Herzliche Grüße u auf ſehr bal<unclear>dgs</unclear>
               Wiederſehn. <anchor type="commentary" xml:id="K_L04456-1"/>
               <date>Heut</date> fahren wir<note type="commentary" corresp="K_L04456-1">Dass das
                  Datum des Poststempels auch der Tag des Abfassung der Postkarte war, bestätigt der
                     <rs type="work" ref="#pmb33243">Tagebuch</rs>eintrag vom letzten Tag in <rs type="place" ref="#pmb44493">Tutzing</rs>, in dem die Personenkonstellation und
                  die Abreise dokumentiert sind: »<quote>Nm. zu <rs type="person" ref="#pmb2315">Liesl</rs>; mit <rs type="person" ref="#pmb12170">Mann</rs>.
                     Abschied.</quote>«, <ref type="schnitzler-tagebuch" target="1912-09-07" subtype="see"/>.</note> nach <rs type="place" ref="#pmb50">Wien</rs>.</p>
            <closer>Ihr <signed>Arthur</signed>
            </closer>
         </div>
         <div n="2" type="writingSession">
            <p>
               <handShift scribe="#pmb2315"/>
               <salute>Lieber Herr Schwarzkopf,</salute> wie schade, dass ich Sie nie seh, aber bald
               komm ich nach <rs type="place" ref="#pmb50">Wien</rs>. Herzlichst<lb/>Ihre
                  <signed>Lisl St.</signed>
            </p>
         </div>
         <div type="writingSession" n="3">
            <p>
               <handShift scribe="#pmb2173"/>Auf sehr baldiges Wiedersehen!</p>
            <closer>Ihre <signed>OlgaS.</signed>
               <space unit="chars" quantity="1"/>
               <lb/>
               <signed>
                  <handShift scribe="#pmb12170"/>Heinrich Mann</signed>
            </closer>
         </div>
      </body>
