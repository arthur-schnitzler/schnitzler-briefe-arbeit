               <addrLine>
                  <hi rend="latintype">
                     <foreign xml:lang="fra">
                        <hi rend="pre-print">M</hi>onsieur le Dr. </foreign></hi></addrLine>
               <addrLine>
                  <hi rend="latintype">Arthur Schnitzler</hi></addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs type="place" ref="#pmb168934">IX. Frankgaſse 1</rs>.</hi></addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs type="place" ref="#pmb50">Wien</rs>.</hi></addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <seg rend="center" type="letterhead">
                  <pb facs="HS.NZ85.1.3169_0032"/>
                  <hi rend="pre-print">
                     <hi rend="capitals">Cour de la <rs type="place" ref="#pmb142350">prison</rs>
                     </hi>
                  </hi>
               </seg>
               <dateline rend="right">
                  <hi rend="pre-print">
                     <rs type="place" ref="#pmb55293">Rennes</rs>
                  </hi>
                  <space unit="chars" quantity="1"/>
                  <hi rend="pre-print">le</hi>
                  <space unit="chars" quantity="1"/>
                  <date when="1899-08-08">8. <hi rend="latintype">août</hi>
                  </date>.</dateline>
            </opener>
            <p>Viele Grüße.</p>
            <p>
               <anchor type="commentary" xml:id="K_L02883-1"/>Wo biſt Du?<note type="commentary" corresp="K_L02883-1">
                  <rs type="person" ref="#pmb2121">Schnitzler</rs> hielt sich noch in <rs type="place" ref="#pmb40306">Italien</rs> auf, langte aber am <ref type="wienerschnitzler" target="1899-08-15" subtype="date-only"/> in <rs type="place" ref="#pmb213">Bad Ischl</rs> an, wohin <rs type="person" ref="#pmb11485">Goldmann</rs> am <ref type="schnitzler-briefe" target="L02884" subtype="date-only"/> seine nächste Karte richtete.</note></p>
            <p>Was machſt Du?</p>
            <closer>Dein <lb/>
               <signed>Paul Goldmann</signed>
            </closer>
         </div>
      </body>
