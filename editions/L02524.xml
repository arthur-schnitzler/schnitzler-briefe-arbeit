   <text>
      <body>
         <div type="writingSession" n="1">
            <p>
               <seg rend="left">
                  <pb facs="MS-SCHNITZLER-B-00067-000-00029"/>
                  <hi rend="pre-print">Dr. Thomas Mann</hi>
               </seg>
               <seg rend="right">
                  <hi rend="pre-print">
                     <rs ref="#pmb45258" type="place">München</rs>, den <anchor type="commentary" xml:id="K_L02524-1"/>
                     <date>14. November 1929</date>
                     <note type="commentary" corresp="K_L02524-1">Entgegen der gedruckten Datierung
                        ist anzunehmen, dass <rs type="person" ref="#pmb12176">Mann</rs> auf die
                        Gratulation vom <ref type="schnitzler-briefe" subtype="date-only" target="L02523"/> geantwortet hat.</note>
                  </hi>
               </seg></p>
            <p rend="center">
               <hi rend="pre-print">Herzlich danke ich für die mir anläßlich der Verleihung des <rs ref="#pmb29679" type="org">Nobelpreises</rs> gewidmeten Glückwünsche.</hi></p>
            <closer>
               <signed>Thomas Mann</signed>
            </closer>
            <postscript>
               <p>In treuer Verehrung!</p>
            </postscript>
         </div>
      </body>
