   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00016-A-00001-000-00271"/>Herrn Dr Arthur
                  Schnitzler</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb59">Wien IX.</rs></addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb168934">Frankgasse 1</rs>.</addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="MS-SCHNITZLER-B-00016-A-00001-000-00272"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb118745">Schneegrube mit Baude</rs>.</hi></p>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00016-A-00001-000-00272"/>Grüsse an Sie und die
               liebenswerthe <anchor type="commentary" xml:id="K_L02866-1"/>Comödie<note type="commentary" corresp="K_L02866-1">unklar; möglicherweise die Komödie, über
                  die <rs type="person" ref="#pmb2121">Schnitzler</rs>
                  <space unit="chars" quantity="1"/>
                  <rs type="person" ref="#pmb11740">Hofmannsthal</rs> am <ref type="schnitzler-briefe" target="L01300" subtype="date-only"/> schrieb.</note></p>
            <closer>
               <signed>OBrahm</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb11617"/>Was freut Sie nur, lieber Herr Schnitzler? Eine Frage,
               die ich von Ihnen mal beantwortet haben möchte. Beim nächsten Wiedersehen!</p>
            <closer>Ihr <signed>Gerhart Hauptmann</signed>
            </closer>
         </div>
         <div type="writingSession" n="3">
            <p>
               <handShift scribe="#pmb11621"/>Freundlicher Gruss<unclear>!</unclear></p>
            <closer>
               <signed>Margarete Marschalk</signed>
            </closer>
         </div>
      </body>
