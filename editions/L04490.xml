         <div type="image">
            <p rend="center">
               <pb facs="HS00048772X_0287"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb213">Bad-Ischl</rs>.</hi>
            </p>
            <p rend="center">
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb1179">Postgasse<space unit="chars" quantity="5"/>Theater</rs>.</hi>
