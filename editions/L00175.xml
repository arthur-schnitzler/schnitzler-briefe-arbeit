   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS.NZ85.1.3604_0007" />Herrn</addrLine>
               <addrLine>
                  <hi rend="latintype">D<hi rend="superscript">r.</hi> Arthur Schnitzler</hi>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb50" type="place">
                     <hi rend="latintype">Wien</hi>
                  </rs>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb412" type="place">I. Grillparzerſtraße 7</rs>. </addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="HS.NZ85.1.3604_0006" />
               <hi rend="pre-print">Gruss aus <rs ref="#pmb42636" type="place">Auerbach’s Keller,
                     Leipzig</rs>.</hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="HS.NZ85.1.3604_0006" />
                  <date>11/II 93</date>.<lb />Ständige Adreſse: <add place="above">bis gegen Ende des
                     Monats</add>
                  <space unit="chars" quantity="1" />
                  <rs ref="#pmb42639" type="place">Berlin, Wienerhof</rs>
                  <lb />
                  <rs ref="#pmb463" type="place">Marienstraße 20</rs>.</dateline>
               <salute>Lieber Schnitzler,</salute>
            </opener>
            <p>Senden Sie, bitte unverzüglich 1 Ex. des »<rs ref="#pmb29935" type="work">
                  <hi rend="latintype">Anatol</hi>
               </rs>« an <rs ref="#pmb12781" type="person">
                  <hi rend="latintype">
                     <hi rend="underline" n="1">J. Simon</hi>
                  </hi>
               </rs> (<rs ref="#pmb652" type="place">
                  <hi rend="latintype">Prag</hi>
               </rs>) <hi rend="latintype">
                  <del rend="strikethrough">
                     <rs ref="#pmb42644" type="place">Raffa</rs>
                  </del>
               </hi>
               <space unit="chars" quantity="1" />
               <rs ref="#pmb42646" type="place">
                  <hi rend="latintype">Park</hi>ſtraße 9</rs> er will <rs ref="#pmb12341" type="person">
                  <hi rend="underline" n="1">Neumann</hi>
               </rs> dafür intereſſiren. Herr <rs ref="#pmb12781" type="person">
                  <hi rend="latintype">
                     <hi rend="underline" n="1">Simon</hi>
                  </hi>
               </rs> iſt der Schwager von <rs ref="#pmb12867" type="person">Joh. <hi rend="latintype">Strauß</hi>
               </rs>. – Herr <rs ref="#pmb2601" type="person">
                  <hi rend="latintype">
                     <hi rend="underline" n="1">Jarno</hi>
                  </hi>
               </rs> vom <rs ref="#pmb42626" type="place">
                  <hi rend="latintype">Residenz</hi>theater</rs> in <rs ref="#pmb168" type="place">
                  <hi rend="latintype">Berlin</hi>
               </rs> läßt Ihnen ſagen, er werde Ihre »<rs ref="#pmb30749" type="work">Frage an das
                  Schickſal</rs>« u. »<rs ref="#pmb30005" type="work">Abſchieds<hi rend="latintype">souper</hi>
               </rs>« heuer im <rs type="org" ref="#pmb42649" subtype="implied">
                  <hi rend="latintype">So<c rendition="#gemination-m" />er</hi>
               </rs> in <subst>
                  <del rend="strikethrough">
                     <rs ref="#pmb213" type="place">
                        <hi rend="latintype">Ishl</hi>
                     </rs>
                  </del>
                  <add place="inline">
                     <rs ref="#pmb213" type="place">
                        <hi rend="latintype">Ischl</hi>
                     </rs>
                  </add>
               </subst>
               <space unit="chars" quantity="1" />ſpielen. Warum ſenden Sie Nichts an das »<rs ref="#pmb29625" type="org">
                  <hi rend="latintype">Magazin</hi>
               </rs>« in <rs ref="#pmb168" type="place">Berlin</rs>? <rs ref="#pmb42660" type="org">
                  <hi rend="latintype">Lehmann</hi>
               </rs> u. <rs ref="#pmb12348" type="person">Neumann-Hofer</rs> intereſſiren ſich ſehr
               für Sie.</p>
            <closer>Gruß <signed>Kafka</signed>
            </closer>
         </div>
      </body>
