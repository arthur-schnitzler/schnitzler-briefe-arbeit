         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="1894_AS_RBH_2_00020"/>
                  <date>Donnerſtag</date>
               </dateline>
               <salute>Lieber Richard,</salute>
            </opener>
            <p>
               <date>Samſtag</date> ko<c rendition="#gemination-m"/>en die Cigaretten, und die <rs type="work" ref="#pmb34888" subtype="implied">2 Bände <pb facs="1894_AS_RBH_2_00021"/>
                  <rs ref="#pmb13897" type="person">
                     <hi rend="latintype">Becque</hi>
                  </rs>
               </rs>.</p>
            <closer>Herzlich Ihr <signed>Arthur.</signed>
            </closer>
            <postscript>
               <dateline>Auch ich komme <date>Samſtag</date>. –</dateline>
            </postscript>
         </div>
      </body>
