      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="1894_AS_RBH_2_00022"/>Hrn <hi rend="latintype">Dr. Rich.
                     Beer-Hofmann</hi>
               </addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs ref="#pmb213" type="place">Ischl</rs>
                  </hi>
               </addrLine>
