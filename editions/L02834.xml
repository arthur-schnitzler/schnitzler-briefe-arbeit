                        <rs type="place" ref="#pmb182">Paris</rs>
                     </hi>, <date when="1897-12-23">23. December</date>.</seg>
               </seg>
               <seg rend="left" type="letterhead">
                  <foreign xml:lang="fra">
                     <hi rend="pre-print">
                        <hi rend="bold">
                           <rs type="place" ref="#pmb43397">10 <hi rend="spaced-out">Rue de la
