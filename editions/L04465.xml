      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0238"/>
                  <rs type="place" ref="#pmb41240">Austria</rs>
               </addrLine>
               <addrLine>Hr Gustav Schwarzkopf</addrLine>
               <addrLine>
