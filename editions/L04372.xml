   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0052"/>Herrn</addrLine>
               <addrLine>Gustav Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">Wien I</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296">Tiefer Graben 23</rs>.</addrLine>
            </address>
         </div>
         <div type="image">
            <seg rend="center">
               <pb facs="HS00048772X_0051"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb90290">Axenstein</rs>, vom <rs type="place" ref="#pmb39755" subtype="implied">See</rs> aus gesehen</hi>
            </seg>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="HS00048772X_0051"/>
                  <date>Sonntag 21. Mai 1910</date>.</dateline>
            </opener>
            <p>
               <pb facs="HS00048772X_0052"/>Herzliche Grüsse!
      Es ist hier so schön, und 
      heiss, und die Berge sind
      voll Schnee, und man
      kann’s nicht beschreiben.
      (Wenigstens <hi rend="underline" n="1">ich</hi> nicht!)</p>
            <closer>
               <signed>Olga</signed>.</closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb2121"/>Glücklicherweise 
      muß man nicht. Herzlichst</p>
            <closer>Ihr
               <signed>A.</signed>
            </closer>
         </div>
      </body>
