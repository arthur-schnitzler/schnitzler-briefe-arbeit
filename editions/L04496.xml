      <body>
         <div type="image">
            <p>
               <pb facs="HS00048772X_0301"/>
               <hi rend="capitals">
                  <hi rend="pre-print">
                     <rs type="place" ref="#pmb363482">’s Gravenhage Bleienburg</rs>
                  </hi>
