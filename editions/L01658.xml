         <div type="writingSession" n="1">
            <p rend="center">
               <pb facs="1907_AS_RBH_1_00003" />
               <hi rend="pre-print">D<hi rend="superscript">r</hi> Arthur Schnitzler</hi>
            </p>
            <p rend="right">
               <rs type="place" ref="#pmb50">
                  <hi rend="pre-print">Wien</hi>
               </rs>
            </p>
            <p>
               <pb facs="1907_AS_RBH_1_00001" />
               <salute>lieber Richard,</salute> erlauben Sie mir Ihnen Herrn Dr. <rs ref="#pmb11312" type="person">
                  <hi rend="latintype">Feuchtwang</hi>
               </rs> vorzuſtellen, <hi rend="latintype">resp</hi>. ihn Ihnen in Eri<c rendition="#gemination-n" />erung zu bringen.</p>
            <closer>Herzlich grüß<unclear>end</unclear>
               <lb />Ihr <signed>Arthur</signed>
            </closer>
            <postscript>
               <p>
                  <date when="1907-02-20">20/2 907</date>
               </p>
            </postscript>
         </div>
