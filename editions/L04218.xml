         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00096-B-000-00259"/>
               <salute>lieber Guſtav,</salute>
               <space unit="chars" quantity="1"/>
               <anchor type="commentary" xml:id="K_L04218-1"/>
               <rs type="event" ref="#pmb183921" subtype="implied">
                  <date>So<c rendition="#gemination-n"/>tag</date> um <time>5</time>
                  <space unit="chars" quantity="1"/>
                  <rs type="work" subtype="implied" ref="#pmb29857">leſe ich
                              vor</rs>
               </rs>
               <note type="commentary" corresp="K_L04218-1">
                  <ref type="schnitzler-kultur" target="pmb183921" subtype="See"/>.</note>. Ich ſchreibe Ihnen ſchon heute, damit Sie ſich nicht anderweitig
               verſagen.</p>
            <closer>Herzlichſt Ihr <signed>ArthSch</signed>
            </closer>
            <postscript>
               <dateline>
                  <date>2<unclear>3</unclear>. 11. 9<unclear>9</unclear>
                  </date>
               </dateline>
            </postscript>
