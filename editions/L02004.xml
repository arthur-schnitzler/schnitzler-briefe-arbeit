         <div type="writingSession" n="1">
            <p>
               <pb facs="96.34.1_2_0010"/>Beſten Dank für die freundlichen Mittheilungen. Aller
               Anfang <c rendition="#dots" n="4"/> Aber ich will nicht gar zu originell ſein.</p>
            <closer>Verbindlichſt grüßt<lb/>Ihr ſehr ergebner<lb/>
               <signed>Arthur Schnitzler</signed>
            </closer>
            <postscript>
               <dateline rend="right">
                  <date>7/2. 911</date>.</dateline>
            </postscript>
         </div>
