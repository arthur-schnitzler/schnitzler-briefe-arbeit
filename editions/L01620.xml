               <addrLine>Herrn D<hi rend="superscript">r</hi> Hugo v. Hofmannsthal</addrLine>
               <addrLine>
                  <rs ref="#pmb186" type="place">Lueg <hi rend="superscript">bei</hi>/St Gilgen am
                     Wolfgangsee</rs></addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="Hs-25714_001"/>
               <hi rend="pre-print">
                  <rs ref="#pmb1284" type="place">Krenborg Slot</rs>.</hi></p>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="Hs-25714_002"/>Kommender Tage froh gedenkend herzlichst
                  <anchor type="commentary" xml:id="K_L01620-1"/>
               <signed>Salten</signed>
               <note type="commentary" corresp="K_L01620-1">
                  <rs type="person" ref="#pmb2167">Saltens</rs> Aufenthalt 
                     in <rs type="place" ref="#pmb43570">Dänemark</rs> ist nur für den <ref type="schnitzler-tagebuch" target="1906-08-02" subtype="date-only"/> belegt. Die vorliegende Karte
                     an <rs type="person" ref="#pmb11740">Hofmannsthal</rs> und jene an <rs type="person" ref="#pmb10863">Beer-Hofmann</rs> (<ref type="schnitzler-briefe" target="L01621"/>)
                     klären den Sachverhalt: Am <ref type="schnitzler-tagebuch" target="1906-08-03" subtype="date-only"/> fand noch ein gemeinsamer Besuch 
                     von <rs type="place" ref="#pmb1284">Schloss Kronborg</rs> statt, bevor sich <rs type="person" ref="#pmb2167">Salten</rs> verabschiedete.</note></p>
            <p>
               <handShift scribe="#pmb2121"/>Herzliche Grüße. Ihr <signed>Arthur</signed></p>
         </div>
      </body>
