   <text>
      <body>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00096-B-000-00363"/>
               <salute>Lieber Guſtav,</salute>
               <space unit="chars" quantity="1"/>
               <date>Montag</date>
               <space unit="chars" quantity="1"/>
               <time>Abends
                  ½ 10</time>
               <space unit="chars" quantity="1"/>
               <anchor type="commentary" xml:id="K_L04187-1"/>
               <rs type="event" subtype="implied" ref="#pmb48949">lieſt <rs type="person" ref="#pmb11701">G. Hirſchf</rs> ſein neues <rs type="work" ref="#pmb39796" subtype="implied">Buch</rs>
               </rs>
               <note type="commentary" corresp="K_L04187-1">
                  <ref type="schnitzler-kultur" target="pmb48949"/>.</note> bei
                  <rs type="place" ref="#pmb168934" subtype="implied">mir</rs> vor. Bitte ko<c rendition="#gemination-m"/>en Sie. Hoffentlich ſeh ich Sie
                  <anchor type="commentary" xml:id="K_L04187-2"/>
               <date>Samſtag</date>
               <space unit="chars" quantity="1"/>
               <time>Abend</time> im <rs type="place" ref="#pmb49">Pfob</rs>
               <note type="commentary" corresp="K_L04187-2">Der Brief ist undatiert, dürfte aber durch
                        die inhaltliche und phraseologische Nähe
                        zeitgleich mit dem an <rs type="person" ref="#pmb10863">Richard Beer-Hofmann</rs> vom <ref type="schnitzler-briefe" subtype="date-only" target="L00868"/> 
                        verfasst sein. Ein Besuch im <rs type="place" ref="#pmb49">Café Pfob</rs> am <date>17. 12. 1898</date> ist nicht im <rs type="work" ref="#pmb33243">Tagebuch</rs>
                     belegt.</note>.</p>
            <closer>Ihr <signed>Arth Sch</signed>
            </closer>
         </div>
      </body>
