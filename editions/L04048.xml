   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00096-B-000-00059"/>
                  <hi rend="latintype">Herrn Gustav Schwarzkopf</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">Wien</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296">Tiefer Graben 23</rs>.</addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="MS-SCHNITZLER-B-00096-B-000-00060"/>
                  <date>17. 10. 904</date>
               </dateline>
            </opener>
            <p>
               <salute>lieber Guſtav,</salute> bitte ko<c rendition="#gemination-m"/>en
               Sie morgen <anchor type="commentary" xml:id="K_L04048-1"/>
               <date>Dinſtag</date>
               <note type="commentary" corresp="K_L04048-1">
                  <ref type="schnitzler-tagebuch" target="1904-10-18" subtype="Cf"/>.</note>
      zum Nachtmahl zu
      uns. Auch Frau <anchor type="commentary" xml:id="K_L04048-2"/>
               <hi rend="latintype">
                  <rs type="person" ref="#pmb24906">Ellyn Karin</rs>
               </hi>, – auf der Durchreiſe von <rs type="place" ref="#pmb30">Salzburg</rs> nach
               <rs type="place" ref="#pmb49008">Zwickau</rs> iſt da<note type="commentary" corresp="K_L04048-2">Ihre Anwesenheit bei <rs type="person" ref="#pmb2121">Schnitzler</rs> ist zwar für den <ref type="schnitzler-tagebuch" target="1904-10-17" subtype="date-only"/>,
                  nicht aber für das Abendessen am <ref type="schnitzler-tagebuch" target="1904-10-18" subtype="date-only"/> belegt.</note>, würde
      Sie ſehr gern ſehen</p>
            <closer>Herzlichst Ihr<lb/>
               <signed>A.</signed>
            </closer>
            <postscript>
               <p>Wir erwarten Sie um <time>½ 8</time>.</p>
            </postscript>
         </div>
      </body>
