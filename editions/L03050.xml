         <div type="writingSession" n="1">
            <p rend="center">
               <pb facs="Widmungsexemplare_Seite_097"/>Meinem lieben Arthur Schnitzler</p>
            <closer>herzlichst<lb/>
               <signed>Salten</signed>
            </closer>
            <postscript>
               <dateline>
                  <rs type="place" ref="#pmb50">Wien</rs>, <anchor type="commentary" xml:id="K_L03050-1"/>
