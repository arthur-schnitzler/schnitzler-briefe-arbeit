               </hi></p>
            <space dim="vertical" unit="line" quantity="1"/>
            <p rend="center">
               <hi rend="pre-print">
                  <hi rend="capitals">Mit Zeichungen</hi>
               </hi></p>
            <p rend="center">
               <hi rend="pre-print">
                  <hi rend="capitals">von</hi>
               </hi></p>
            <p rend="center">
               <hi rend="pre-print">
                  <hi rend="capitals">
                     <rs type="person" ref="#pmb19478">Leo <hi rend="spaced-out">Kober</hi>
                     </rs>
                  </hi>
               </hi></p>
            <space dim="vertical" unit="line" quantity="1"/>
            <p rend="center">
               <hi rend="pre-print">
                  <hi rend="capitals">
                     <rs type="place" ref="#pmb45258">München</rs> und <rs type="place" ref="#pmb864">Leipzig</rs>
                  </hi>
               </hi></p>
            <p rend="center">
               <hi rend="pre-print">
                  <hi rend="capitals">Bei <rs type="org" ref="#pmb29584">Georg Müller</rs>
                  </hi>
               </hi></p>
         </div>
