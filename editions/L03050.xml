                  <note type="commentary" corresp="K_L03050-1">am <date when="1905-10-28">27. 10. 1905</date> vom <rs type="work" ref="#pmb47979">Börsenblatt für
                     den deutschen Buchhandel</rs> als Neuerscheinung für Anfang November angekündigt</note>
               </dateline>
            </postscript>
            <space dim="vertical" unit="line" quantity="1"/>
            <p rend="center">
               <hi rend="pre-print">
                  <hi rend="capitals">
                     <hi rend="bold">
                        <rs type="work" ref="#pmb143503">
                           <hi rend="bold">
                              <hi rend="spaced-out">Das Buch
                              der</hi>
                           </hi>
                           <space unit="chars" quantity="1"/>
                           <lb/>
                           <hi rend="bold">
                              <hi rend="spaced-out">Könige</hi>
                           </hi>
                        </rs>
                     </hi>
                  </hi>
               </hi></p>
            <p rend="center">
