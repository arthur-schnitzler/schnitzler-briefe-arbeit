      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-0008-B-00001-000-00100"/>
                  <hi rend="pre-print">A</hi>n D<hi rend="superscript">r</hi> Arthur
                  Schnitzler</addrLine>
               <addrLine>
                  <rs ref="#pmb41240" type="place">Austria</rs>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb50" type="place">Wien</rs>
