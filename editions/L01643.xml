   <text>
      <body>
         <div type="writingSession" n="1">
            <opener>
               <salute>
                  <pb facs="61.587_0001" />Lieber Herr Schnitzler.</salute>
            </opener>
            <p>Ich habe herzlich dankbar Ihre <anchor type="commentary" xml:id="K_L01643-1" />
               <rs type="person" ref="#pmb43855" subtype="implied">Theilnahme</rs>
               <note type="commentary" corresp="K_L01643-1">Am <date>10. 12. 1906</date> war die
                  Mutter <rs type="person" ref="#pmb43855">Marie Hauptmann</rs> gestorben.</note>
               empfunden. Lassen Sie mich Ihnen die Hand drücken und seien Sie gegrüsst.</p>
            <closer>Ihr<lb />
               <signed>Gerhart Hauptmann</signed>
            </closer>
            <postscript>
               <dateline>
                  <rs type="place" ref="#pmb735">Agnetendorf</rs>
                  <lb />d. <date>18 Dec 1906</date>
               </dateline>
            </postscript>
         </div>
      </body>
