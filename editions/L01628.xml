   <text>
      <body>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="center">
                  <pb facs="MS-SCHNITZLER-B-00043-B-00002-000-00241"/>
                  <date>Mittwoch</date>
               </dateline>
            </opener>
            <p>Kommen direct; freuen uns. Bitten durch <rs ref="#pmb23635" type="person">Rosenbaum</rs> für morgen <date>Donnerstag</date>
               <space unit="chars" quantity="1"/>
               <time>7<hi rend="superscript">h</hi> abends</time> zweibettiges Zimmer möglichst
               billig, neues Gebäude, höheres Stockwerk, <hi rend="underline" n="1">nach
                  rückwärts</hi>, bestellen.</p>
            <closer>Herzlich<signed>Hugo.</signed>
            </closer>
         </div>
      </body>
