   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-0008-B-00001-000-00178" />Herrn</addrLine>
               <addrLine>D<hi rend="superscript">r</hi> Arthur Schnitzler</addrLine>
               <addrLine>
                  <rs ref="#pmb50" type="place">Wien</rs>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb168934" type="place">IX Frankgasse 1</rs>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-0008-B-00001-000-00177" />
               <salute>
                  <damage agent="paperloss">
                     <supplied>Li</supplied>
                  </damage>eber Arthur!</salute> Ich wohne <rs ref="#pmb680" type="place">Baden
                  Franzensstraße <hi n="1" rend="underline">54</hi>
                  <space unit="chars" quantity="1" />
                  <hi rend="underline" n="1">Thüre 8</hi>
               </rs>
            </p>
            <p>Ich bin dort, oder, zu den Essenzeiten und auch am <hi n="1" rend="underline">Vormittag</hi> bei meinem <rs type="person" ref="#pmb13913" subtype="implied">Papa</rs>. <rs ref="#pmb40115" type="place">
                  <hi rend="underline" n="1">Antonsgasse</hi> 4</rs>.</p>
            <closer>Herzlichst<lb />Ihr<lb />
               <signed>Richard</signed>
            </closer>
            <postscript>
               <p>Grüße an <rs ref="#pmb12740" type="person">Schwarzkopf</rs>
                  <space unit="chars" quantity="1" />
                  <rs ref="#pmb2167" type="person">Salten</rs> und <rs ref="#pmb11740" type="person">Hugo</rs> (?) <add place="below">wo ist er?</add>
               </p>
            </postscript>
         </div>
      </body>
