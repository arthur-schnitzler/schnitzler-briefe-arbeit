   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS.NZ85.1.5204_0001" />Frau</addrLine>
               <addrLine>Olga Schnitzler</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb68">Wien XVIII</rs>.</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb168940">Spöttelgasse 7</rs>
               </addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="HS.NZ85.1.5204_0002" />
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb50107">Buckow Märk.-Schweiz</rs> – <rs type="place" ref="#pmb50109">Neue Promenade</rs>
               </hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="HS.NZ85.1.5204_0002" />
               <anchor type="textConst" xml:id="T_L01600-1" />Das ist<note type="textConst" corresp="T_L01600-1">durch einen Strich auf der Abbildung kenntlich gemacht</note>
               unsere Wohnung. Im 1<hi rend="superscript">ten</hi> Stock.</p>
            <p>
               <pb facs="HS.NZ85.1.5204_0001" />Schreib, Elende!</p>
            <p>Elende ſchreib!</p>
            <closer>Deine <lb />
               <signed>Mirjam.</signed>
            </closer>
         </div>
      </body>
