      <body>
         <div type="writingSession" n="1">
            <p>
               <pb facs="3222_Schnitzler_Dämmerseelen_001" />Meinem lieben Hugo</p>
            <closer>
               <signed>Arthur</signed>
            </closer>
            <postscript>
               <dateline>
                  <rs type="place" ref="#pmb50">Wien</rs>
                  <space unit="chars" quantity="1" />
                  <anchor type="commentary" xml:id="K_L01661-1" />
                  <date>März 907</date>
                  <note type="commentary" corresp="K_L01661-1">Am <ref target="1907-03-07" subtype="date-only" type="schnitzler-tagebuch" /> notierte <rs type="person" ref="#pmb2121">Schnitzler</rs> das Erscheinen. Am
                        <date>8. 3. 1907</date> wurde es vom <rs type="work" ref="#pmb47979">Börsenblatt für
                        den deutschen Buchhandel</rs> als Neuerscheinung gemeldet. Die Datierung erfolgt analog
                  zum Widmungsexemplar für <rs type="person" ref="#pmb2167">Salten</rs> vom <ref type="schnitzler-briefe" target="L03612" subtype="date-only" />.</note>.</dateline>
            </postscript>
         </div>
         <div type="writingSession" n="2">
            <space dim="vertical" unit="line" quantity="1" />
            <p rend="center">
               <pb facs="3222_Schnitzler_Dämmerseelen_002" />
