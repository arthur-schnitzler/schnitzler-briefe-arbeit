            <address>
               <addrLine>
                  <pb facs="Hs-30885,71_002" />Herrn Hugo von Hofmannsthal</addrLine>
               <addrLine>
                  <hi rend="latintype">kuk Ltnd i. d. R. des kuk VIII. Ulan-Rgmts</hi>
               </addrLine>
               <addrLine>
                  <hi rend="latintype">
