               <seg rend="left" type="letterhead">
                  <foreign xml:lang="fra">
                     <hi rend="pre-print">
                        <hi rend="bold">Paraissant trois fois par jour.</hi>
                     </hi>
                  </foreign>
               </seg>
               <seg type="letterhead">
                  <seg rend="left">
                     <foreign xml:lang="fra">
                        <hi rend="pre-print">
