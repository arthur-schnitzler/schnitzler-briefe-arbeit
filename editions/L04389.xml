                  </rs>
               </addrLine>
            </address>
         </div>
         <div type="image">
            <seg rend="center">
               <pb facs="HS00048772X_0085"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb113">Türkenschanz-Park</rs> gegen <rs type="place" ref="#pmb90705">Gersthof</rs>.</hi>
               <space unit="chars" quantity="3"/>
