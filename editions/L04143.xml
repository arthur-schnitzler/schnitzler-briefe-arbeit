               </seg>
               <seg>
                  <hi rend="pre-print">
                     <rs type="place" ref="#pmb133">Wien XVIII.
                        Spoettelgasse 7</rs>.</hi>
               </seg>
               <salute>lieber Guſtav,</salute>
            </opener>
            <p>
               <anchor type="commentary" xml:id="K_L04143-1"/>
               <rs type="person" ref="#pmb2173">Olga</rs> ka<c rendition="#gemination-n"/> nicht ausgehn<note type="commentary" corresp="K_L04143-1">
                  <ref type="schnitzler-tagebuch" target="1909-02-14" subtype="Cf"/>.</note>; hier ihr <anchor type="commentary" xml:id="K_L04143-2"/>
               <rs type="event" subtype="implied" ref="#pmb209550">Sitz</rs>
               <note type="commentary" corresp="K_L04143-2">Für die 
                   <rs type="event" ref="#pmb209550">Aufführung von <rs type="work" ref="#pmb80217">Die junge Frau</rs> von <rs type="person" ref="#pmb17528">Albert Guinon</rs>
                  </rs> im <rs type="place" ref="#pmb40">Theater in der Josefstadt</rs>. <rs type="person" ref="#pmb12740">Schwarzkopf</rs> nahm die Einladung an.</note> auf dem ich Sie Abends vorzufinden
               hoffe</p>
            <closer>Herzlich<lb/> Ihr<lb/>
               <signed>A.</signed>
            </closer>
         </div>
