         <div type="image">
            <p>
               <pb facs="HS00048772X_0193"/>
               <hi rend="capitals">
                  <hi rend="pre-print">
                     <rs type="place" ref="#pmb51794">St Johann am <anchor type="commentary"
                           xml:id="K_L04444-1"/>Wocheinersee<note type="commentary"
                           corresp="K_L04444-1">Die Karte ist nicht datiert. <rs type="person"
                              ref="#pmb2121">Arthur</rs> und <rs type="person" ref="#pmb2173">Olga
                              Schnitzler</rs> verbrachten die Tage vom <ref type="wienerschnitzler"
                              target="1907-06-28" subtype="date-only"/> bis zum <ref
                              type="wienerschnitzler" target="1907-01-07" subtype="date-only"/> in
                           der <rs type="place" ref="#pmb1205">Wochein</rs>. Unter Zuhilfenahme des
                           Poststempels der bei gleicher Gelegenheit entstandenen Postkarte von <ref
                              type="schnitzler-briefe" target="L01687"/>, lässt sich auf dem
                           Poststempel der vorliegenden Karte eine »29« entziffern und eine
                           Datierung auf den <date>29. 6. 1907</date> vornehmen.</note>
                     </rs>.</hi>
               </hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="HS00048772X_0194"/>Herzliche Grüße!</p>
            <closer>Ihr <signed>Arthur</signed>
               <lb/>
               <signed>
                  <handShift scribe="#pmb2173"/>Olga S.</signed>
            </closer>
         </div>
      </body>
