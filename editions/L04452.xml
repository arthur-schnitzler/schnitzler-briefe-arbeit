         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="HS00048772X_0210"/>
                  <date>
                     <anchor type="textConst" xml:id="T_L04452-1"/>3. 4. 912<note type="textConst" corresp="T_L04452-1">Die Datierung befindet sich über dem vorgesehenen Textfeld der Karte, die für die übrige Beschriftung aber um 90° gedreht wurde, sodass die Datierung nicht über, sondern neben dem Text seitlich aufgestellt steht.</note>
                  </date>
               </dateline>
               <salute>Herzliche Grüße!</salute>
            </opener>
            <p>Es ſchneit und
      regnet.</p>
            <closer>Ihr<lb/>
               <signed>Arthur</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb2173"/>Herzlichst <signed>Olga</signed>
            </p>
         </div>
         <div type="writingSession" n="3">
            <p>
               <handShift scribe="#pmb2315"/>Die alte ergebene <lb/>
               <signed>Lisl Steinrück</signed>
            </p>
         </div>
