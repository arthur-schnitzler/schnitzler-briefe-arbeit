   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00043-B-00002-000-00049"/>
                  <hi rend="latintype">Herrn D<hi rend="superscript">r</hi> Arthur Schnitzler</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">
                     <hi rend="latintype">Wien</hi>
                  </rs>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb168934" type="place">
                     <hi rend="latintype">IX. Franckgasse 1</hi>
                  </rs>. </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00043-B-00002-000-00050"/>
               <salute>lieber,</salute> falls aber in
                  <hi rend="latintype">
                  <rs ref="#pmb30" type="place">Salzburg</rs>
               </hi> ſchönes, wirklich so<c rendition="#gemination-m"/>erliches Wetter, mit dem
               Charakter des Bleibenden ſein ſollte, ſo telegrafiren Sie mir <hi rend="underline" n="1">ſogleich</hi>.</p>
            <closer>Ihr<lb/>
               <signed>Hugo.</signed>
            </closer>
         </div>
      </body>
