   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00096-B-000-00077"/>Herrn Guſtav Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296">Tiefer Graben 23</rs></addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">
                     <hi rend="latintype">Wien I</hi>
                  </rs>.</addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00096-B-000-00078"/>
               <salute>lieber Guſtav,</salute> Sie ſind ſehr herzlich zu <anchor type="commentary" xml:id="K_L04057-1"/>
               <date>Freitag</date> Abend<note type="commentary" corresp="K_L04057-1">Für Freitag,
                  den <ref type="schnitzler-tagebuch" target="1904-08-19" subtype="date-only"/> ist
                  kein Besuch <rs type="person" ref="#pmb12740">Schwarzkopfs</rs> im <rs type="work" ref="#pmb33243">Tagebuch</rs> erwähnt und auch kein Aufenthalt <rs type="person" ref="#pmb2121">Schnitzlers</rs> in der <rs type="place" ref="#pmb168934">Frankgasse 1</rs>. Am Folgetag sucht <rs type="person" ref="#pmb2121">Schnitzler</rs>
                  <space unit="chars" quantity="1"/>
                  <rs type="person" ref="#pmb12740">Schwarzkopf</rs> bei ihm zuhause auf.</note>
               <space unit="chars" quantity="1"/>
               <rs type="place" ref="#pmb168934">
                  <hi rend="underline" n="1">Frank</hi>gaſſe</rs> (vor <time>8</time>) gebeten. Wenn
               ja Antwort unnöthg</p>
            <closer>Herzlichſt<lb/> Ihr<lb/>
               <signed>A.</signed>
            </closer>
         </div>
      </body>
