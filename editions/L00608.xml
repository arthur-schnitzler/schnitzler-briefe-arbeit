   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="1896_AS_RBH_2_00005"/>Herrn <hi rend="latintype">Dr. Rich.
                     Beer-Hofmann</hi>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb50" type="place">Wien</rs>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb190427" type="place">I. <hi rend="latintype">Wollzeile 15</hi>
                  </rs>,</addrLine>
               <addrLine>4. Stock.</addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <salute>
                  <pb facs="1896_AS_RBH_2_00004"/>Lieber Richard.</salute>
            </opener>
            <p>Morgen geh ich ins <rs type="event" ref="#pmb43270" subtype="implied">
                  <hi rend="latintype">Raimund</hi>theat</rs> (<rs type="work" ref="#pmb43268">Ebne Erde u erſter Stock</rs>.)</p>
            <p>
               <anchor type="commentary" xml:id="K_L00608-1"/>Montag reiſe ich ſpäteſtens<note type="commentary" corresp="K_L00608-1">Das trat ein, <ref type="wienerschnitzler" target="1896-10-26" subtype="cf"/>.</note> ab. <anchor type="commentary" xml:id="K_L00608-2"/>
               <rs type="event" ref="#pmb35152" subtype="implied">
                  <rs type="work" ref="#pmb29899" subtype="implied">
                     <hi rend="latintype">Première</hi>
                  </rs>
               </rs>
               <space unit="chars" quantity="1"/>ſchon am <date>31.</date>
               <note type="commentary" corresp="K_L00608-2">Die <rs type="event" ref="#pmb35152">Uraufführung von <rs type="work" ref="#pmb29899">Freiwild</rs></rs> fand erst am <ref type="schnitzler-kultur" subtype="date-only" target="pmb35152"></ref>  im <rs type="place" ref="#pmb3">Deutsches Theater Berlin</rs> statt.</note> –</p>
            <p>Schreib<unclear>en</unclear> Sie mir wo Sie morgen Abend ſind <hi rend="latintype">etc</hi>.</p>
            <closer>Herzlich der Ihre<lb/>
               <signed>Arthur</signed>
            </closer>
         </div>
      </body>
