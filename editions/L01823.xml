   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="https://www.theatermuseum.at/de/object/88f9c35196/" />Herrn Hermann
                  Bahr</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb165">Wien Ober St Veit.</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb220">Veitliſſengaſſe.</rs>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="https://www.theatermuseum.at/de/object/88f9c35196/" />
               <hi rend="pre-print">Dr. Arthur Schnitzler</hi>
               <lb />
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb168940">Wien XVIII. Spoettelgasse 7</rs>.</hi>
            </p>
            <p>
               <salute>mein lieber Hermann,</salute>
               <space unit="chars" quantity="1" />
               <hi rend="underline" n="1">we<damage agent="hole">
                     <supplied>
                        <c rendition="#gemination-n" />
                     </supplied>
                  </damage> es dich nicht im Arbeiten ſtört</hi>, würd ich gern einen Vormittag
               nächſter Woche (circa ½ 12), den du ſelbſt beſti<c rendition="#gemination-m" />en
               magſt, auf ein längeres Viertelſtündchen zu dir hinaus ko<c rendition="#gemination-m" />en. <pb facs="https://www.theatermuseum.at/de/object/88f9c35196/" />Haſt du keine
               Zeit, ſo ſags ungenirt</p>
            <closer>herzlichſt dein<lb />
               <signed>Arthur</signed>
            </closer>
            <postscript>
               <dateline>
                  <date>16. <anchor type="textConst" xml:id="T_L01823-1" />9.<note type="textConst" corresp="T_L01823-1">offensichtlicher
                     Schreibirrtum</note> 09</date>. </dateline>
            </postscript>
         </div>
      </body>
