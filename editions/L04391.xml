         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="HS00048772X_0090"/>
                  <date>9/2 908</date>
               </dateline>
               <salute>Lieber Guſtav,</salute>
            </opener>
            <p>kommen Sie doch! Wir bleiben noch über 8 Tage. Es iſt ſehr ſchön.</p>
            <closer>herzlichſt Ihr<lb/>
               <signed>Arthur</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb2173"/>
               <anchor type="textConst" xml:id="T_L04391-1"/>Es wäre sehr schön, Sie hier zu sehen,<note type="textConst" corresp="T_L04391-1">
                  <rs ref="#pmb2173" type="person">Olga Schnitzlers</rs> Gruß ist am rechten Rand des Textfeldes um 90° gedreht platziert.</note> und es würde
               Ihnen gewiss sehr wol tun.</p>
            <closer>Herzliche Grüsse.<lb/>
               <signed>OlgaS.</signed>
            </closer>
         </div>
         <div type="writingSession" n="3">
            <p>
               <pb facs="HS00048772X_0089"/>
               <handShift scribe="#pmb12701"/>Herzliche Grüße ſendet</p>
            <closer>
               <signed>Louise Schnitzler</signed>
            </closer>
         </div>
      </body>
