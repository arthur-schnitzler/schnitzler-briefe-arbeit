         <div type="image">
            <p>
               <pb facs="HS00048772X_0347"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb353718">Villa Meran</rs>.</hi>
               <space unit="chars" quantity="5"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb27068">Schneeberg</rs>, 2075 m.</hi>
               <space unit="chars" quantity="5"/>
               <hi rend="pre-print">
