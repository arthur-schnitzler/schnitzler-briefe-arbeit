            </p>
         </div>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0348"/>Herrn <hi rend="latintype">Gustav Schwarzkopf</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">
                     <hi rend="latintype">Wien I</hi>
                  </rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296">
                     <hi rend="latintype">Tiefer Graben 23</hi>
                  </rs>
