         <div type="writingSession" n="1">
            <p>
               <pb facs="Widmungsexemplare_Seite_028"/>Meinem lieben Arthur</p>
            <closer>herzlichſt<lb/>
               <signed>HermannB.</signed>
            </closer>
            <postscript>
               <p>
                  <date>Juni 1903.</date></p>
            </postscript>
            <space dim="vertical" unit="line" quantity="1"/>
            <p rend="center">
               <hi rend="pre-print">
                  <rs ref="#pmb29891" type="work">Rezenſionen</rs>
               </hi></p>
         </div>
         <div type="writingSession" n="2">
            <space dim="vertical" unit="line" quantity="1"/>
            <p rend="center">
               <pb facs="Widmungsexemplare_Seite_027"/>
               <hi rend="pre-print">Hermann Bahr</hi></p>
            <p rend="center">
               <hi rend="pre-print">
                  <rs ref="#pmb29891" type="work">
                     <hi rend="bold">Rezenſionen</hi>
                  </rs>
               </hi></p>
            <p rend="center">
               <hi rend="pre-print">Wiener Theater</hi></p>
            <p rend="center">
               <hi rend="pre-print">
                  <date>1901</date> bis <date>1903</date>
               </hi></p>
            <space dim="vertical" unit="line" quantity="1"/>
            <p rend="right">
               <hi rend="pre-print">
                  <rs type="work" ref="#pmb31249" subtype="implied">»Wenn die Leute glauben,<lb/>ich
                     wäre noch in <rs type="place" ref="#pmb197">Weimar</rs>,<lb/> dann bin ich
                     ſchon in <rs type="place" ref="#pmb48759">Erfurt</rs>.«</rs>
               </hi></p>
            <p rend="right">
               <hi rend="pre-print">
                  <rs type="person" ref="#pmb11461">
                     <hi rend="spaced-out">Goethe</hi>.</rs>
               </hi></p>
            <space dim="vertical" unit="line" quantity="1"/>
            <p rend="center">
               <hi rend="pre-print">
                  <rs ref="#pmb168" type="place">
                     <hi rend="bold">Berlin</hi>
                  </rs>
                  <space unit="chars" quantity="1"/>
                  <date>1903</date>
               </hi></p>
            <p rend="center">
               <hi rend="pre-print">
                  <rs ref="#pmb29639" type="org">
                     <hi rend="bold">S. Fiſcher, Verlag</hi>
                  </rs>
               </hi></p>
         </div>
