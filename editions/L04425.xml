      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0156"/>Herrn Guſtav Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">Wien I</rs>
               </addrLine>
               <addrLine>
