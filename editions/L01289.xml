   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-0008-B-00002-000-00039"/>Herrn D<hi rend="superscript">r</hi> Arthur Schnitzler</addrLine>
               <addrLine>
                  <rs ref="#pmb168934" type="place">IX Frankgasse 1</rs>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-0008-B-00002-000-00040"/>
               <salute>Lieber!</salute> Besuch (<rs ref="#pmb20914" type="person">R. Mandl</rs>) der
               sich für <time>Nachmittag</time> ansagt zwingt mich wieder <time>Mittags</time> zu
               Hause zu sein. Ihr</p>
            <p>
               <time>Nm 5<hi rend="superscript">h.</hi>
               </time> aufgestandener</p>
            <closer>
               <signed>R.</signed>
            </closer>
         </div>
      </body>
