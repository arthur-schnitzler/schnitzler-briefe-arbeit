         <div type="writingSession" n="1">
            <p>
               <pb facs="HS00048772X_0149"/>Herzliche Grüße! Aber nicht der Mond  ſcheint – ſondern der Regen.</p>
            <closer>Ihr <signed>Arth Sch.</signed>
            </closer>
         </div>
