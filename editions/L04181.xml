   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00096-B-000-00347"/>Herrn Guſtav
                  Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">Wien</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296">I. Tiefer Graben 23</rs>.</addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00096-B-000-00348"/>Ich <anchor type="commentary" xml:id="K_L04181-1"/>fahre <time>10 Uhr</time>
               <space unit="chars" quantity="1"/>
               <rs type="place" ref="#pmb132">Südbahn</rs> nach <rs type="place" ref="#pmb968">Mödling</rs>
               <note type="commentary" corresp="K_L04181-1">Es
                  handelte sich um eine Verabredung für den Folgetag. <rs type="person" ref="#pmb12740">Schwarzkopf</rs> fuhr nicht mit, <ref type="schnitzler-briefe" target="L04179" subtype="see"/>.</note> ab, erwarte Sie bis 5 Minuten
               vorher unten in der Halle</p>
            <closer>Herzlichſt Ihr <lb/>
               <signed>A.</signed>
            </closer>
         </div>
      </body>
