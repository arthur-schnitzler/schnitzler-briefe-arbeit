      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0216"/>Herrn <hi rend="latintype">Gustav Schwarzkopf</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">
                     <hi rend="latintype">Wien</hi>
                  </rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207301">
                     <hi rend="latintype">I. Tiefer Graben 17</hi>
                  </rs>
               </addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="HS00048772X_0215"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb45260">Insel Brioni i.d. Adria</rs>
               </hi>
            </p>
            <p rend="center">
               <hi rend="pre-print">Sonnenuntergang</hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="HS00048772X_0216"/>
                  <date>30/7 12</date>
               </dateline>
            </opener>
            <p>Sie ſind wohl ſchon wieder daheim? Wir fühlen uns hier ſehr wohl, grüßen Sie
               herzlichſt!</p>
            <closer>Ihr <signed>Arthur</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb2173"/>Hier müssen Sie einmal herkommen, es ist so schön!</p>
            <closer>
               <signed>Olga</signed>
            </closer>
         </div>
      </body>
