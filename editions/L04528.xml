   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0370"/>Hrn</addrLine>
               <addrLine>Gustav Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">Wien I</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207301">Tiefer Graben 17</rs>
               </addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="HS00048772X_0369"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb44374">St. Moritz-Dorf</rs> im Winter</hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="HS00048772X_0370"/>Herzliche Grüße! Die <anchor type="commentary" xml:id="K_L04528-1"/>
               <rs type="event" ref="#pmb183497 #pmb183503 #pmb183512 #pmb183521 #pmb183530 #pmb183543 #pmb183557" subtype="implied">7 Vorlesungen</rs>
               <note type="commentary" corresp="K_L04528-1">
                  <ref type="schnitzler-kultur" target="pmb183497"/>; <ref type="schnitzler-kultur" target="pmb183503"/>; <ref type="schnitzler-kultur" target="pmb183512"/>; <ref type="schnitzler-kultur" target="pmb183521"/>; <ref type="schnitzler-kultur" target="pmb183530"/>; <ref type="schnitzler-kultur" target="pmb183543"/>; <ref type="schnitzler-kultur" target="pmb183557"/>.</note> sind glücklich vorbei,
               und ich will hier die obligate <anchor type="commentary" xml:id="K_L04528-2"/>Erkältung<note type="commentary" corresp="K_L04528-2">
                  <ref type="schnitzler-tagebuch" target="1925-01-23" subtype="Cf"/>.</note>
               auscuriren. Ich schrieb Ihnen <anchor type="commentary" xml:id="K_L04528-3"/>von <rs type="place" ref="#pmb631">Freiburg</rs>
               <note type="commentary" corresp="K_L04528-3">
                  <ref type="schnitzler-briefe" target="L04356"/>.</note> aus. Wollen Sie mir ein
               Wort hieher (<rs type="place" ref="#pmb239882">
                  <hi rend="underline" n="1">Privathotel</hi>
               </rs>) adressiren, wies bei Ihnen geht?</p>
            <closer>Ihr<lb/>
               <signed>A.</signed>
            </closer>
         </div>
      </body>
