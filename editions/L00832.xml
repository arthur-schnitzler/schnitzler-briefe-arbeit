            <p rend="right">
               <pb facs="MS-SCHNITZLER-B-00043-B-00001-000-00271" />
               <hi rend="stamp">
                  <hi rend="capitals">
                     <rs ref="#pmb39752" type="place">Tegernsee</rs>
                  </hi>
               </hi>
            </p>
            <p>Bin aus vielen Gründen ſchon <date>Mittwoch</date>
               <space unit="chars" quantity="1" />
               <time>Abend</time> in <rs ref="#pmb854" type="place">Baſel</rs> bitte Drahtantwort
                  <rs ref="#pmb75" type="place">Hinterbrühl</rs> ob ſie ſpäteſtens
                  <date>Donnerſtag</date> auch dort ſein können und welches Gaſthaus</p>
            <closer>
               <signed>Hugo</signed>
            </closer>
            <postscript>
               <p>
                  <pb facs="MS-SCHNITZLER-B-00043-B-00001-000-00272" />
                  <rs ref="#pmb34028" type="place">
