      <body>
         <div type="writingSession" n="1">
            <opener>
               <seg type="letterhead">
                  <anchor type="textConst" xml:id="T_L00412-1" />
                  <pb facs="HS.NZ85.1.3483_0012" />
                  <hi rend="pre-print">
                     <rs ref="#pmb29244" type="org">Oesterreichische Central-Boden-Credit-Bank
                        Wien</rs>.</hi>
                  <note type="textConst" corresp="T_L00412-1">quer am linken Rand</note>
               </seg>
               <salute>Lieber Freund!</salute>
            </opener>
            <p>
               <rs type="person" ref="#pmb11740">Hugo</rs> der ziemlich ſtark erkältet iſt möchte
               von 8 Uhr ab den Abend mit Ihnen verbringen wenn es Ihnen paßt oder ev. ſpäter ins
               Kafféhaus ko<c rendition="#gemination-m" />en u bittet Sie um Nachricht <rs type="place" ref="#pmb192623">
                  <hi rend="latintype">Salesianergaſse</hi>
               </rs>. Freundſchaftlichſt</p>
            <closer>Ihr<lb />
               <signed>D<hi rend="superscript">r</hi> Hofmannsthal</signed>
            </closer>
            <postscript>
               <dateline>
                  <date>
                     <anchor type="commentary" xml:id="K_L00412-1" />Sonntag<note type="commentary" corresp="K_L00412-1">Das Korrespondenzstück ist undatiert.
                        Als ein möglicher Abend, den <rs type="person" ref="#pmb2121">Schnitzler</rs> und <rs type="person" ref="#pmb11740">Hugo von
                           Hofmannsthal</rs> gemeinsam an einem Sonntag im Kaffeehaus verbracht haben,
                        bietet sich der <ref target="1894-12-30" subtype="date-only" type="schnitzler-tagebuch" /> an, wenngleich auch andere Daten in größerer
                        Runde denkbar sind.</note>
                  </date>.</dateline>
            </postscript>
         </div>
      </body>
