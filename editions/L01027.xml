      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="Hs-30885,91_002" />Hugo von Hofmannsthal</addrLine>
               <addrLine>
                  <rs ref="#pmb182" type="place">Paris</rs>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb34022" type="place">192 Boulevard Haussman</rs>
               </addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="Hs-30885,91_001" />
               <hi rend="pre-print">
                  <rs ref="#pmb34020" type="place">Spalato – Split. Porta aurea</rs>.</hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="Hs-30885,91_001" />
               <salute>lieber Hugo,</salute> ich bin in <rs ref="#pmb873" type="place">Trieſt</rs> u
                  <rs ref="#pmb682" type="place">Raguſa</rs> geweſen, habe manches merkwürdige
               geſehen, bin heute in <rs ref="#pmb4231" type="place">Spalato</rs>, fahre Nachts nach
                  <rs ref="#pmb38096" type="place">Abazia</rs> und fühle, dſs ich ſehr allein
               bin.</p>
            <closer>Ihr <signed>Arthur</signed>
            </closer>
         </div>
      </body>
