      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0104"/>Herrn <hi rend="latintype">Gustav
                     Schwarzkopf</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">
                     <hi rend="latintype">Wien I</hi>
