   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00096-B-000-00055"/>Herrn Guſtav
                  Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">Wien I</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296">Tiefer Graben 23</rs>.</addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00096-B-000-00056"/>
               <salute>lieber Guſtav,</salute> wir haben <anchor type="commentary" xml:id="K_L04046-1"/>morgen <date>Samſtag</date>
               <note type="commentary" corresp="K_L04046-1">
                  <ref type="schnitzler-tagebuch" target="1904-10-22" subtype="date-only"/>.</note> eine Loge in
               die <rs type="event" ref="#pmb209337" subtype="implied">
                  <rs type="place" ref="#pmb40">Josefſtadt</rs>
               </rs>, 1. Rang, links, 3, wohin Sie freundlichſt <anchor type="commentary" xml:id="K_L04046-2"/>geladen<note type="commentary" corresp="K_L04046-2">
                  <rs type="person" ref="#pmb12740">Schwarzkopf</rs> nahm teil.</note> ſind.</p>
            <closer>Herzlichſt<lb/> Ihr<lb/>
               <signed>Arthur</signed>
            </closer>
         </div>
      </body>
