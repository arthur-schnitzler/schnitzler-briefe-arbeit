   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0172"/>Herrn <hi rend="latintype">Gustav Schwarzkopf</hi></addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50"><hi rend="latintype">Wien</hi></rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296"><hi rend="latintype">I Tiefer Graben 23</hi></rs>.</addrLine>
            </address>
         </div>
         <div type="image">
            <seg rend="center">
               <pb facs="HS00048772X_0171"/>
               <hi rend="pre-print">Der
                  <rs type="place" ref="#pmb364260">Dürenstein</rs> (<rs type="place" ref="#pmb364256">Pragser Thal</rs>).</hi>
            </seg>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="HS00048772X_0171"/>
               <date>Heute</date> früh um 6 »aufgebrochen«. Um 8, <rs type="place" ref="#pmb364264">Alt Prags</rs>, frühſücken 
      wir und grüßen Sie herzlich. Vorläufig ohne <anchor type="commentary" xml:id="K_L04433-1"/>Landauer<note type="commentary" corresp="K_L04433-1">eine Art Kutsche</note>
               <signed>ArthurSchn</signed>
            </p>
            <postscript>
               <p>Einige Worte <anchor type="commentary" xml:id="K_L04433-2"/>Freitag <hi rend="latintype">
                     <rs type="place" ref="#pmb40260">Bozen</rs>
                  </hi>
                  <note type="commentary" corresp="K_L04433-2">Die Ankunft in <rs type="place" ref="#pmb40260">Bozen</rs> erfolgte
               erst einen Tag später, am <ref type="wienerschnitzler" target="1899-08-12" subtype="date-only"/>.</note>
                  <space unit="chars" quantity="1"/>
                  <hi rend="latintype"><anchor type="commentary" xml:id="K_L04433-3"/>post. rest<note type="commentary" corresp="K_L04433-3">poste restante: postlagernd</note></hi> zu finden, würde 
      <unclear>uns</unclear> freun.</p>
            </postscript>
         </div>
         <div type="writingSession" n="2">
            <closer>
               <signed>
                  <handShift scribe="#pmb13055"/>Wassermann</signed>
            </closer>
         </div>
         <div type="writingSession" n="3">
            <closer>
               <signed>
                  <handShift scribe="#pmb10863"/>Richard</signed>
            </closer>
         </div>
      </body>
