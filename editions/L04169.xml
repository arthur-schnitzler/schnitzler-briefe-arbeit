            <p>
               <pb facs="MS-SCHNITZLER-B-00096-B-000-00324"/>
               <salute>lieber Guſtav,</salute> am <date>Dinſtag</date>
               <space unit="chars" quantity="1"/>
               <time>Abend ½ 7</time>
               <space unit="chars" quantity="1"/>
               <anchor type="commentary" xml:id="K_L04169-1"/>
               <rs type="event" ref="#pmb334014" subtype="implied">lieſt</rs>
               <space unit="chars" quantity="1"/>
               <rs type="person" ref="#pmb11740">Hugo</rs> bei <rs type="place" ref="#pmb168815" subtype="implied">mir</rs> den <rs type="work" ref="#pmb30341">Roſencavalier</rs>
               <note type="commentary" corresp="K_L04169-1">
                  <ref type="schnitzler-kultur" subtype="See" target="pmb334014"/>.</note> vor, wozu er
               Sie freundlichſt bittet.</p>
            <closer>Herzlichſt Ihr<lb/>
               <signed>A.</signed>
            </closer>
         </div>
