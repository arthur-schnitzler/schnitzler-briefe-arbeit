   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="1900_AS_RBH_3_00033" />Hrn <hi rend="latintype">Dr. Rich.
                     Beer-Hofmann</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">Wien</rs>
               </addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs type="place" ref="#pmb338">I. <anchor type="commentary" xml:id="K_L00120-1" />Wollzeile 15<note type="commentary" corresp="K_L00120-1">Das
                           Korrespondenzstück ist undatiert. Durch die Übersiedlung <rs type="person" ref="#pmb10863">Beer-Hofmanns</rs>s im <date>September
                              1892</date> in die <rs type="place" ref="#pmb338">Wollzeile</rs>, wo
                           er bis <date>Ende April 1901</date> wohnte, ist eine grobe Zuordnung
                           möglich.</note>
                     </rs>.</hi>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="1900_AS_RBH_3_00034" />
               <salute>lieber Richard,</salute>  hier iſt der <rs type="person" ref="#pmb49374" subtype="implied">Herr</rs> mit dem Winterrock, <hi rend="latintype">resp.</hi>
               ohne den Winterrock.</p>
            <closer>Ihr <signed>Arthur.</signed>
            </closer>
            <postscript>
               <p>
                  <pb facs="1900_AS_RBH_3_00035" />Vielleicht geben Sie ihm auch ein paar Kreuzer. Er
                  fährt nach <rs type="place" ref="#pmb332">Linz</rs>.</p>
            </postscript>
         </div>
      </body>
