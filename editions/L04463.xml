      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0234"/>Hrn Gustav Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">Wien</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207301">I. Tiefer Graben 17</rs>
