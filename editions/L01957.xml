   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00113-000-00096"/>Herrn D<hi rend="superscript">r</hi>
                  Arthur Schnitzler (u. ſ. f.)</addrLine>
               <addrLine>
                  <rs ref="#pmb50" type="place">Wien</rs></addrLine>
               <addrLine>
                  <rs ref="#pmb168815" type="place">XIX Sternwartestrasse 7<subst>
                        <del rend="overwritten">2</del>
                        <add place="inline">1</add>
                     </subst>
                  </rs></addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="MS-SCHNITZLER-B-00113-000-00095"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb51804">Gosau</rs>. <rs ref="#pmb51799" type="place">Gasthof Gosauschmied</rs> mit den <rs type="place" ref="#pmb51847">Donnerkogln</rs>.</hi></p>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00113-000-00096"/>Alles Liebe von einer schönen Landpartie:
               Es grüßt Sie beide</p>
            <closer>
               <signed>Julie Wassermann</signed>
               <lb/>
               <signed>
                  <handShift scribe="#pmb10788"/>Raoul Auernheimer</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb2292"/>Wie schön, wenn Ihr auch mit wäret.</p>
            <closer>
               <signed>Gerty.</signed>
            </closer>
         </div>
         <div type="writingSession" n="3">
            <p>
               <handShift scribe="#pmb13055"/>Herzlichst grüsst</p>
            <closer>
               <signed>JakobW.</signed>
               <lb/>
               <signed>
                  <handShift scribe="#pmb11740"/>Hugo</signed>
            </closer>
         </div>
         <div type="writingSession" n="4">
            <p>
               <handShift scribe="#pmb3223"/>Die herzlichsten Grüsse von</p>
            <closer>
               <signed>IreneAuernheimer</signed>
            </closer>
         </div>
      </body>
