         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00043-B-00002-000-00180"/>
               <anchor type="commentary" xml:id="K_L01473-1"/>Morgen <date>Freitag</date>
               <note type="commentary" corresp="K_L01473-1">
                  <ref type="schnitzler-tagebuch" target="1904-12-02" subtype="See"/>.</note> wäre <hi rend="latintype">rendezvous</hi> ſehr
                    erwünſcht weil wieder abreiſen muſs.</p>
            <p>Wenn Sie nicht <hi rend="underline" n="1">vormittag</hi> »nein« telegrafieren,
                    ſind wir <time>8 Uhr</time>
               <space unit="chars" quantity="1"/>
               <rs ref="#pmb304" type="place">Kuffner</rs>.</p>
            <closer>
               <signed>Hugo.</signed>
            </closer>
         </div>
      </body>
