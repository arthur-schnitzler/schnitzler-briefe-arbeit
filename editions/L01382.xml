   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00043-B-00002-000-00151"/>Herrn D<hi rend="superscript">r</hi> Arthur Schnitzler</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">Wien</rs>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb168940" type="place">XVIII Spöttelgasse 7</rs>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="MS-SCHNITZLER-B-00043-B-00002-000-00152"/>
                  <date>14.</date>
               </dateline>
            </opener>
            <p>
               <salute>Lieber,</salute> wir möchten lieber <date>
                  <hi rend="underline" n="1">Freitag</hi>
               </date>
               <time>abend</time> ko<c rendition="#gemination-m"/>en, um <time>7<hi rend="superscript">h</hi>
               </time>, ſind aber in der Zeit nicht gedrängt weil wir danach in der Stadt
               übernachten. Wenn Sie nicht antworten, iſt Ihnen der Tag recht.</p>
            <closer>Von Herzen<lb/>
               <signed>Hugo</signed>
            </closer>
            <postscript>
               <p>
                  <hi rend="latintype">P. S.</hi> Laden Sie vielleicht einmal <rs ref="#pmb12740" type="person">S-kopf</rs> dazu? Ich ſehe ihn monatelang nicht.</p>
            </postscript>
         </div>
      </body>
