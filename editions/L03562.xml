      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00089-B-00002-000-00020-V"/>Herrn u. Frau D<hi rend="superscript">r</hi> Arthur Schnitzler</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">Wien</rs></addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb168815">XVIII. Sternwartestraße 71</rs></addrLine>
            </address>
         </div>
         <div type="image">
            <seg>
               <seg rend="left">
                  <pb facs="MS-SCHNITZLER-B-00089-B-00002-000-00020-R"/>
                  <hi rend="capitals">
                     <hi rend="pre-print">
                        <rs type="place" ref="#pmb147403">Zoologischer Garten Berlin</rs>.</hi>
                  </hi>
               </seg>
               <seg rend="right">
                  <hi rend="pre-print">Löwe.</hi>
