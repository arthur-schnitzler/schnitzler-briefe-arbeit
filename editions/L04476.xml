               <pb facs="HS00048772X_0259"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb1098">Gran Canaria</rs> – Vega de <rs type="place" ref="#pmb363846">Santa Brigida</rs>.</hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="HS00048772X_0260"/>
                  <rs type="place" ref="#pmb44097">
                     <anchor type="textConst" xml:id="T_L04476-2"/>San<note type="textConst" corresp="T_L04476-2">gut zu lesen, trotzdem vermutlich »<quote>Las</quote>« gemeint</note> Palmas</rs> auf
               <rs type="place" ref="#pmb1098">Gran Canaria</rs>, das also wirklich
      existirt. <date>29. 4. 26</date>
               </dateline>
            </opener>
            <p>Herzliche Grüße Ihnen
               und den verehrten <rs type="person" ref="#pmb24645 #pmb24648" subtype="implied">Brüdern</rs>.</p>
            <p>Märchenhaft schön!</p>
            <closer>Ihr <signed>Arthur</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb2238"/>Schönste Grüße</p>
            <closer>
               <signed>Lili S.</signed>
            </closer>
         </div>
      </body>
