         <div type="writingSession" n="1">
            <p>
               <pb facs="HS00048772X_0321"/>Mit herzlichen Grüßen!</p>
            <closer>
               <signed>ArthSch</signed>
               <lb/>
               <handShift scribe="#pmb10863"/>
               <signed>Richard</signed>
               <lb/>
               <handShift scribe="#pmb11485"/>
               <signed>Dr. Paul Goldmann.</signed>
            </closer>
            <postscript>
               <p>
                  <handShift scribe="#pmb2121"/>(Frl. <rs type="person" ref="#pmb17502">G.</rs> wird
                     <anchor type="commentary" xml:id="K_L04506-1"/>die <rs type="work" ref="#pmb30486" subtype="implied">Novelle</rs>
                  <note type="commentary" corresp="K_L04506-1">Im Brief vom <ref type="schnitzler-briefe" target="L04080" subtype="date-only"/> erwähnte <rs type="person" ref="#pmb2121">Schnitzler</rs>, dass er den Text von <rs type="work" ref="#pmb30486">Frau
                        Bertha Garlan</rs> durch seine Schreibkraft <rs type="person" ref="#pmb17502">Ida Grünwald</rs> an <rs type="person" ref="#pmb12740">Schwarzkopf</rs> hatte überbringen lassen.</note> holen.)</p>
               <dateline>
                  <date>23. 8. 900</date>
               </dateline>
            </postscript>
         </div>
