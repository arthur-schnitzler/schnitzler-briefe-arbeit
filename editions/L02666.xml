                  <hi rend="latintype">Herrn</hi></addrLine>
               <addrLine>
                  <hi rend="latintype">Dr. Arthur Schnitzler</hi></addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs type="place" ref="#pmb50">Wien</rs></hi></addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs type="place" ref="#pmb167789">I. Giselastraſse 11</rs>.</hi></addrLine>
