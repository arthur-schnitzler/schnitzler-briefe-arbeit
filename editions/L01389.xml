   <text>
      <body>
         <div type="writingSession" n="1">
            <opener>
               <salute>
                  <pb facs="MS-SCHNITZLER-B-00043-B-00002-000-00133"/>mein lieber Arthur</salute>
            </opener>
            <p>darf ich Ihnen Herrn <rs ref="#pmb13014" type="person">Vollmöller</rs> den Dichter
               der <rs ref="#pmb40229" type="work">
                  <hi rend="latintype">Catharina von Armagnac</hi>
               </rs> vorſtellen.</p>
            <p>Er denkt ſehr vernünftig und mit Liebe von Ihren ſchönen Arbeiten.</p>
            <closer>Ihr<lb/>
               <signed>Hugo.</signed>
            </closer>
         </div>
      </body>
