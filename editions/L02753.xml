                        <hi rend="bold">
                           <foreign xml:lang="fra">Fondateur M. <rs type="person" ref="#pmb87771">L.
                                 Sonnemann</rs>
                           </foreign>.</hi>
                     </hi>
                  </seg>
                  <seg rend="right">
                     <hi rend="latintype">
                        <rs type="place" ref="#pmb182">Paris</rs>
                     </hi>, <date when="1895-10-15">1<subst>
                           <del rend="overwritten">
                              <unclear>4</unclear>
                           </del>
                           <add place="inline">5</add>
                        </subst>. October</date>.</seg>
               </seg>
               <seg rend="left" type="letterhead">
                  <foreign xml:lang="fra">
                     <hi rend="pre-print">Journal politique, financier,</hi>
                  </foreign>
