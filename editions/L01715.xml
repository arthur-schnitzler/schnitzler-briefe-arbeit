   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="1907_AS_RBH_1_00043" />
                  <hi rend="pre-print">Dr. Arthur Schnitzler</hi>
               </addrLine>
               <addrLine>
                  <hi rend="pre-print">
                     <rs type="place" ref="#pmb168940">Wien XVIII. Spoettelgasse 7</rs>.</hi>
               </addrLine>
            </address>
            <address>
               <addrLine>Herrn <hi rend="latintype">Dr. Richard Beerhofmann</hi>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb68" type="place">Wien XVIII</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb235251">
                     <hi rend="latintype">Hasenauerstraße 59</hi>
                  </rs>. </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="1907_AS_RBH_1_00044" />Wir bitten Sie und <rs type="person" ref="#pmb10860">Paula</rs> morgen <date>Dinſtag</date>
               <space unit="chars" quantity="1" />
               <time>Abend</time> bei uns zu ſpeiſen. <rs type="person" ref="#pmb11485">Paul
                  Goldm.</rs> u <rs type="person" ref="#pmb26392">Leo Vanj.</rs> ſind verſtändigt.
                  Ko<c rendition="#gemination-m" />en Sie nicht ſpät. (<time>½ 8</time> etwa.) </p>
            <closer>Herzlichſt Ihr<lb />
               <signed>A.</signed>
            </closer>
         </div>
      </body>
