   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="1892_AS_RBH_2_00008" />
                  <hi rend="latintype">Herrn Doctor Richard Beer-Hofmann</hi>
               </addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs ref="#pmb50" type="place">Wien</rs>
                  </hi>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb338" type="place">I Wollzeile 15</rs>.</addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="1892_AS_RBH_2_00006" />
                  <date when="1892-12-27">27/12 92</date>
               </dateline>
               <salute>Lieber Richard,</salute>
            </opener>
            <p>hier der Sitz, leider nur mehr à <subst>
                  <del rend="overwritten">
                     <unclear>3</unclear>
                  </del>
                  <add place="inline">2</add>
               </subst> fl erhältlich</p>
            <closer>Herzlich Ihr<lb />
               <signed>Arthur</signed>
            </closer>
            <postscript>
               <p>
                  <rs ref="#pmb18523" type="person">
                     <hi rend="latintype">Horn</hi>
                  </rs>
                  <space unit="chars" quantity="1" />ſchreibt mir, <pb facs="1892_AS_RBH_2_00007" />daſs er <date>Donnerſtag</date> erſt um <time>8</time> zu Frau <rs ref="#pmb16312" type="person">
                     <hi rend="latintype">Flegma<c rendition="#gemination-n" />
                     </hi>
                  </rs> ko<c rendition="#gemination-m" />t, Gott wie mies iſt mir! Bitte ko<c rendition="#gemination-m" />en Sie ſicher, vielleicht gelingt uns das Mislingen
                  (Wortſpiel).</p>
            </postscript>
         </div>
      </body>
