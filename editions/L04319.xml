      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00096-A-000-00067"/>
                  <rs type="place" ref="#pmb207301">I. Tiefer Graben 17</rs>.</addrLine>
