      <body>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="HS.NZ85.1.2577_0006" />
                  <rs ref="#pmb1275" type="place">Friedrichshagen</rs>
                  <lb /> Wilhelmſtr. 72.</dateline>
               <salute>Hochgeehrter Herr Doktor!</salute>
            </opener>
            <p>Bitte <rs type="work" ref="#pmb30169" subtype="implied">ſenden Sie</rs> möglichſt
               bald, – doch weiß ich nicht, ob ich noch etwas in’s <rs type="work" ref="#pmb36166" subtype="implied">Maiheft</rs>
               <space unit="chars" quantity="1" />ſtopfen kann, das ganz voll iſt.</p>
            <closer>Mit beſtem Gruß<lb /> Ihr<lb />
               <signed>W. Bölsche</signed>
            </closer>
         </div>
      </body>
