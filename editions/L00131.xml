      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="1892_AS_RBH_2_00025"/>
                  <hi rend="latintype">Herrn Dr. Rich Beer Hofmann</hi>
               </addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs ref="#pmb50" type="place">Wien</rs>.</hi>
               </addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs ref="#pmb190427" type="place">I Wollzeile 15</rs>
                  </hi>.</addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <salute>
                  <pb facs="1892_AS_RBH_2_00026"/>Lieber Richard,</salute>
            </opener>
            <p>mein <rs ref="#pmb12695" type="person">Papa</rs>
               <space unit="chars" quantity="1"/>ſagt mir zu, auch für Sie den <anchor type="commentary" xml:id="K_L00131-1"/>
               <rs type="event" subtype="implied" ref="#pmb41110">
                  <rs ref="#pmb31971" type="work">Musotte</rs>
                  <space unit="chars" quantity="1"/>Sitz</rs>
               <note type="commentary" corresp="K_L00131-1">
                  <ref type="schnitzler-kultur" target="pmb41110" subtype="Cf"/>.</note> zu beſorgen.</p>
            <closer>Herzlichſt<lb/> Ihr <signed>Arthur</signed>
            </closer>
         </div>
      </body>
