         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00096-A-000-00024"/>Herrn D<hi rend="superscript">r</hi> Arthur Schnitzler</addrLine>
               <addrLine>
