         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00096-A-000-00023"/>
               <salute>Lieber,</salute> Danke herzlich für Ihren <anchor type="commentary" xml:id="K_L04250-1"/>Brief<note type="commentary" corresp="K_L04250-1">
                  <ref type="schnitzler-briefe" target="L03009"/>.</note>. Ich schreibe Ihnen morgen
               ausführlich. Inzwischen nur eilig viele Grüße von uns zu Ihnen.</p>
            <closer>Ihr <signed>Salten</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb23918"/>Viele Grüße</p>
            <closer>
               <signed>Otti</signed>
            </closer>
         </div>
      </body>
