         <div type="writingSession" n="1">
            <p>
               <pb facs="1903_AS_RBH_1_00045" />Ich bitte Sie allſo <date>Mittwoch</date>
               <space unit="chars" quantity="1" />
               <time>halb eins</time>
               <space unit="chars" quantity="1" />
               <anchor type="commentary" xml:id="K_L01312-1" />
               <rs type="place" ref="#pmb44464">Schopenhauergaſſe 37</rs>
               <note type="commentary" corresp="K_L01312-1">
                  <rs type="place" ref="#pmb44464">Schopenhauerstraße 39</rs> war die Adresse der
                     <rs type="org" ref="#pmb44466" subtype="implied">Synagoge</rs>, in der am <ref target="1903-08-26" type="schnitzler-tagebuch" subtype="date-only" /> die
                  Trauung von <rs type="person" ref="#pmb2121">Schnitzler</rs> und <rs type="person" ref="#pmb2173">Olga Gussmann</rs> stattfand.</note> als Beistand zu fungiren
               und die Sache durchaus als vertraulich zu behandeln</p>
            <closer>Herzlichſt Ihr <signed>Arthur</signed>
            </closer>
         </div>
