   <text>
      <body>
         <div type="writingSession" n="1">
            <opener>
               <seg>
                  <seg rend="left">
                     <hi rend="pre-print">A. S.</hi>
                  </seg>
                  <seg rend="right">
                     <pb facs="0040_FL81799581"/>
                     <date>16. X. 911</date>. </seg>
               </seg>
            </opener>
            <p>
               <salute>lieber Herr Doktor,</salute> ich danke Ihnen herzlich für Ihren <anchor type="commentary" xml:id="K_L03788-1"/>
               <rs type="event" subtype="implied" ref="#pmb88534 #pmb88554 #pmb88558 #pmb88562 #pmb88566 #pmb88570 #pmb88573">Glückwunſch</rs>
               <note type="commentary" corresp="K_L03788-1">Dieser ist nicht erhalten. 
                  Die <rs type="event" ref="#pmb88534">Premiere von <rs type="work" ref="#pmb30207">Das weite Land</rs>
                  </rs> hatte am <ref type="schnitzler-kultur" target="pmb88534" subtype="date-only"/> am <rs type="org" ref="#pmb36247">Burgtheater</rs> und in sechs weiteren
                     deutschsprachigen Städten stattgefunden.</note> u
               grüße Sie!</p>
            <closer>Ihr<lb/>
               <signed>Arthur Schnitzler</signed>
            </closer>
         </div>
      </body>
