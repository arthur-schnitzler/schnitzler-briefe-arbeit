            <address>
               <addrLine>
                  <pb facs="1912_AS_RBH_1_00008"/>
                  <hi rend="latintype">Dr. Richard BeerHofmann aus <rs type="place" ref="#pmb50">Wien</rs></hi></addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs type="place" ref="#pmb310">Hotel Bauer u Grünwald</rs></hi></addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs type="place" ref="#pmb462">Venedig</rs></hi></addrLine>
               <addrLine>nachſenden: <hi rend="latintype">(nach <rs type="place" ref="#pmb235251">Wien
                        XVIII Hasenauerstr 59</rs>)</hi></addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="1912_AS_RBH_1_00007"/>
               <hi rend="pre-print">
                  <supplied type="image-description">Römische Ausgrabungen</supplied>
               </hi></p>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="center">
                  <pb facs="1912_AS_RBH_1_00007"/>
                  <date>13. 5. 912</date>.</dateline>
            </opener>
            <p>
               <pb facs="1912_AS_RBH_1_00008"/>
               <rs type="place" ref="#pmb45260">Brioni</rs> iſt <hi rend="underline" n="1">bezaubernd</hi>. Hotel vorzüglich. Wir haben gemiethet. Rathen Ihnen von Herzen
               das gleiche! Meer, Wald, Wieſen, Vergangenheit.</p>
            <closer>Herzlichſt Ihr <signed>A.</signed>
            </closer>
            <postscript>
               <p>Hoffen <hi rend="underline" n="1">
                     <anchor type="commentary" xml:id="K_L02063-1"/>Mittwoch<note type="commentary" corresp="K_L02063-1">
                        <ref target="1912-05-15" type="schnitzler-tagebuch" subtype="See"/>.
                     </note> Abend</hi> in <rs type="place" ref="#pmb462">Vened</rs>
                  <space unit="chars" quantity="1"/>
                  <anchor type="textConst" xml:id="T_L02063-1"/>
                  <rs type="place" ref="#pmb34050">
                     <hi rend="latintype">Europe</hi>
                  </rs> zu ſein.<note type="textConst" corresp="T_L02063-1">quer zum Text entlang
                     des oberen Kartenrandes</note></p>
            </postscript>
         </div>
