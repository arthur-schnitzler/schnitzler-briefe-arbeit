      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="1900_AS_RBH_3_00014"/>Hn Dr. <hi rend="latintype">Richard</hi></addrLine>
               <addrLine>
                  <hi rend="latintype">Beer-Hofmann</hi></addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb34401">
                     <hi rend="latintype">Altaussee</hi>
                  </rs></addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="1900_AS_RBH_3_00015"/>
                  <date>5. 8. 900</date>
               </dateline>
            </opener>
            <p>
               <salute>lieber Richard,</salute>
               <space unit="chars" quantity="1"/>
               <rs type="person" ref="#pmb12740">Guſtav</rs> ko<c rendition="#gemination-m"/>t nicht
               nach <rs type="place" ref="#pmb30">Salzburg</rs>. Von <rs type="person" ref="#pmb2167">Salten</rs> keine Nachricht. Wir können nun wohl <date>Montag
                  13.</date>
               <space unit="chars" quantity="1"/>
               <time>Nachmittag 3 Uhr</time> endgiltg abreiſen und <rs type="place" ref="#pmb30">S.</rs> feſtſetzen. Vielleicht ko<c rendition="#gemination-m"/> ich <anchor type="commentary" xml:id="K_L01066-1"/>
               <date>Mittwoch</date>
               <note type="commentary" corresp="K_L01066-1">
                  <ref target="1900-08-08" subtype="See" type="schnitzler-tagebuch"/>.
               </note> nach <rs type="place" ref="#pmb415">Auſſee</rs>, würde Ihnen noch früher
               ſchreiben <hi rend="latintype">resp.</hi> telegr.</p>
            <closer>Herzlichſt<lb/>
               <signed>Arth</signed>
            </closer>
            <postscript>
               <p>
                  <anchor type="textConst" xml:id="T_L01066-1"/>
                  <anchor type="commentary" xml:id="K_L01066-2"/>Wer wohnt
                     <rs type="place" ref="#pmb49335">Puchen</rs> Nr. 57?<note type="commentary" corresp="K_L01066-2">Laut <rs type="work" ref="#pmb49338">Ausseer Cur- und Fremden-Liste</rs> (<bibl>Nr. 15,
                           <date>18. 7. 1900</date>, S. 2</bibl>) »<quote>
                        <rs type="person" ref="#pmb49340">Frau Henriette Schönwald</rs>, Private,
                        mit Familie und Dienerschaft, aus <rs type="place" ref="#pmb50">Wien</rs>
                     </quote>« (6 Personen)</note>
                  <note type="textConst" corresp="T_L01066-1">am oberen Rand
                     auf dem Kopf</note></p>
            </postscript>
         </div>
      </body>
