            <p>
               <rs type="person" ref="#pmb11740">Hugo</rs> bittet Sie die <rs type="work" ref="#pmb40595" subtype="implied">Beilage</rs> ehethunlichst an D<hi rend="superscript">r</hi>
               <space unit="chars" quantity="1"/>
               <rs ref="#pmb11485" type="person">Paul Goldmann</rs> gelangen zu laſſen.</p>
            <closer>Mit besten Grüßen Ihr ergebenster<lb/>
               <signed>D<hi rend="superscript">r</hi>Hofmannsthal</signed>
            </closer>
            <postscript>
               <dateline>
                  <date>22/3 1900</date>.</dateline>
            </postscript>
