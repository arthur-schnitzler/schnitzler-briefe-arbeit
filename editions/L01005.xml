               <addrLine>
                  <rs ref="#pmb168934" type="place">IX Frankgasse 1</rs>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb50" type="place">Wien</rs>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-0008-B-00001-000-00327" />
               <salute>Lieber Arthur!</salute> Ich und <rs ref="#pmb11740" type="person">Hugo</rs>
               speisen heute nach dem Conzert <rs ref="#pmb7438" type="person">Gmeiner</rs> im <rs type="org" ref="#pmb43143">Club</rs>. Auch <rs ref="#pmb3130" type="person">Frankenstein</rs> ko<c rendition="#gemination-m" />t.</p>
            <closer>Herzlichst<lb />
               <signed>Richard</signed>
            </closer>
         </div>
      </body>
