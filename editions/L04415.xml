         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="HS00048772X_0135"/>
                  <date>16. 5.</date>
               </dateline>
            </opener>
            <p>Viele Grüße u ſchönen Dank für die lieben <anchor type="commentary" xml:id="K_L04415-1"/>
               <subst>
                  <del rend="overwritten">Ka</del>
                  <add place="inline">Na</add>
               </subst>chrichten<note type="commentary" corresp="K_L04415-1">
                  <ref type="schnitzler-briefe" target="L04313"/>.</note>. Wann ſoll die <rs type="event" subtype="implied" ref="#pmb333620">
                  <rs type="work" ref="#pmb300273" subtype="implied">
                     <hi rend="latintype">Première</hi>
                  </rs>
               </rs> ſein?</p>
            <p>Nachricht nach <rs type="place" ref="#pmb906">Taormina</rs>
               <space unit="chars" quantity="1"/>
               <anchor type="commentary" xml:id="K_L04415-2"/>
               <hi rend="latintype">postrest</hi>
               <note type="commentary" corresp="K_L04415-2">poste restante: postlagernd</note> erbeten. –</p>
            <closer>Herzlich<lb/>Ihr <signed>A.</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb2173"/>Herzl. Grüsse, und schreiben Sie bald wieder so einen lieben Brief!</p>
            <closer>
               <signed>Olga S.</signed>
            </closer>
         </div>
      </body>
