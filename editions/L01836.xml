         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="NLJ0010" />29. 3. 09</dateline>
               <seg type="letterhead">
                  <hi rend="pre-print">Dr. Arthur Schnitzler</hi>
                  <lb />
                  <hi rend="pre-print">
                     <rs ref="#pmb168940" type="place">Wien XVIII. Spoettelgasse 7</rs>.</hi>
               </seg>
               <salute>lieber Herr Ehrenſtein,</salute>
            </opener>
            <p>von Ihren <rs type="org" ref="#pmb29496" subtype="implied">rundſchauerlichen</rs>
               <space unit="chars" quantity="1" />Schickſalen zu erfahren würd mich intereſſieren u
               ich erwarte Sie we<c rendition="#gemination-n" />s Ihnen paſſt am Mittwoch um 7 Uhr
               Abends.</p>
            <closer>beſtens grüßend<space unit="chars" quantity="3" />Ihr <signed>A. S.</signed>
            </closer>
         </div>
