         <div type="writingSession" n="1">
            <opener>
               <seg rend="center" type="letterhead">
                  <pb facs="1900_AS_RBH_3_00018"/>
                  <hi rend="pre-print">
                     <rs type="place" ref="#pmb49343">Bormio</rs>
                  </hi>
               </seg>
               <seg rend="center" type="letterhead">
                  <hi rend="pre-print">
                     <hi rend="capitals">
                        <rs type="place" ref="#pmb49345">I vecchi bagni</rs>.</hi>
                  </hi>
               </seg>
               <dateline>
                  <date when="1900-08-26">26. 8. 900</date>.</dateline>
            </opener>
            <p>Schönes Wetter, zerriſſene Straßen, <anchor type="commentary" xml:id="K_L01068-1"/>
               <rs type="place" ref="#pmb423 #pmb969">Tirol</rs>er Sänger<note type="commentary" corresp="K_L01068-1">Das Erlebnis des Sängers/der Sänger dürfte für die Entwicklung
                  der Novelle <rs type="work" ref="#pmb30649">Der blinde Geronimo und sein
                     Bruder</rs> bedeutsam geworden sein, <ref type="schnitzler-briefe" subtype="cf" target="L02928"/>, 
                  <ref type="schnitzler-briefe" target="L03059"/> und <bibl>
                     <rs type="person" ref="#pmb11485">Paul Goldmann</rs>: <rs type="work" ref="#pmb148130">Erinnerungen an Arthur Schnitzler</rs>. In: <rs type="work" ref="#pmb36374">Neue Freie Presse</rs>, Nr. 24.121, <date when="1931-11-08">8. 11. 1931</date>, Morgenblatt, S. 25–26, hier: S. 26</bibl>.</note>,
               herzliche Grüße.</p>
            <closer>
               <signed>Arthur</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb11485"/>Ich wünſche Du wäreſt auch da.</p>
            <closer>Herzlichſt<lb/>
               <signed>Paul Goldmann.</signed>
            </closer>
         </div>
