      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0176"/>Herrn <hi rend="latintype">Gustav Schwarzkopf</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">Wien</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296">
                     <hi rend="latintype">Tiefer Graben 23</hi>
                  </rs>
               </addrLine>
            </address>
         </div>
         <div type="image">
            <seg rend="center">
               <pb facs="HS00048772X_0175"/>
               <hi rend="pre-print">Un Saluto da <hi rend="capitals">
                     <rs type="place" ref="#pmb90170">Predazzo</rs>
                  </hi>.</hi>
            </seg>
            <seg rend="center">
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb90170">Predazzo</rs>
                  m. <rs type="place" ref="#pmb254386">Lattemar</rs>.</hi>
            </seg>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="HS00048772X_0175"/>
                  <date>Mittwoch 9/8 99</date>.</dateline>
            </opener>
            <p>
               <date>Montag</date> über <rs type="place" ref="#pmb43070">Giau</rs>, und <hi rend="latintype">
                  <rs type="place" ref="#pmb90446">Caprile</rs>
               </hi>
               <space unit="chars" quantity="1"/>
               <date>geſtern</date> über <hi rend="latintype">
                  <rs type="place" ref="#pmb90084">Fedaja</rs>
               </hi> nach <hi rend="latintype">
                  <rs type="place" ref="#pmb40362">Vigo</rs>
               </hi> –
      alles zu Fuſs!! <date>Heute</date> nicht
      wegen Regen, mit der Post hieher.</p>
            <closer>Viele herzliche Grüße.<lb/>
               <signed>Arthur</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <closer>
               <signed>
                  <handShift scribe="#pmb10863"/>Richard</signed>
            </closer>
            <postscript>
               <p>
                  <rs type="person" ref="#pmb13055">Wassermann</rs> grüsst – aber wirklich!</p>
            </postscript>
         </div>
      </body>
