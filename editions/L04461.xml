         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="HS00048772X_0230"/>
                  <date>17/4 28</date>
               </dateline>
            </opener>
            <p>Abends, nach Abfahrt
               von <rs type="place" ref="#pmb91014">Katakolon</rs>, viele 
               herzliche Grüße,
      auch von meiner lieben
               <rs type="person" ref="#pmb2238" subtype="implied">Reisebegleiterin</rs>. Grüßen Sie
      Dr <rs type="person" ref="#pmb24648">Max</rs>.</p>
            <closer>Ihr <signed>Arthur</signed>
            </closer>
         </div>
