      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0224"/>Herrn</addrLine>
               <addrLine>
                  <hi rend="latintype">Gustav Schwarzkopf</hi>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">Wien I</rs>
               </addrLine>
               <addrLine>
