      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0174"/>Herrn Guſtav Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">Wien</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296">I. Tiefer Graben 23</rs>.</addrLine>
            </address>
         </div>
         <div type="image">
            <seg rend="right">
               <pb facs="HS00048772X_0173"/>
               <rs type="person" ref="#pmb364523">
                  <hi rend="pre-print">
                     <hi rend="bold">
                        <anchor type="commentary" xml:id="K_L04434-55"/>Fr.
                           Hochreiter<note type="commentary" corresp="K_L04434-55">Möglicherweise
                           ließ sich <rs type="person" ref="#pmb2121">Schnitzler</rs> vom Namen des
                           (lokal durchaus bekannten) Fotografen <rs type="person" ref="#pmb364523">Friedrich Hochreiter</rs> zum Namen des Fabrikaten »<quote>Friedrich
                              Hofreiter</quote>« in <rs type="work" ref="#pmb300236">Das weite
                              Land</rs> inspirieren.</note>
                     </hi>
                  </hi>
               </rs>
            </seg>
            <seg>
               <seg rend="left">
                  <rs type="place" ref="#pmb39930">
                     <hi rend="pre-print">
                        <hi rend="bold">
                           <anchor type="commentary" xml:id="K_L04434-1"/>Windischgarsten<note type="commentary" corresp="K_L04434-1">Nur zwei
                              Aufenthalte <rs type="person" ref="#pmb2121">Schnitzlers</rs> in <rs type="place" ref="#pmb39930">Windischgarsten</rs> sind nachweisbar
                                 (<date>1902</date>, <date>1928</date>). Durch die verwendete
                              Briefmarke ist gesichert, dass die Karte vom ersten stammt. Insgesamt blieb
                              <rs type="person" ref="#pmb2121">Schnitzler</rs> drei Tage. Am zweiten
                                 sandte er eine Karte (<ref type="schnitzler-briefe" target="L04412"/>), so dass
                                 anzunehmen ist, dass die vorliegende dieser vorangeht und die Ankunft in <rs type="place" ref="#pmb39930">Windischgarsten</rs> mitteilt.</note>
                           (O.–Oe.)</hi>
                     </hi>
                  </rs>
               </seg>
               <seg rend="right">
                  <hi rend="pre-print">
                     <rs type="place" ref="#pmb39930">Windischgarsten (O.–Ö.)</rs>
                     <space unit="chars" quantity="1"/>
                     <date>190<hi rend="bold">2</hi>
                     </date>
                  </hi>
               </seg>
            </seg>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="HS00048772X_0173"/>Herzliche Grüße!</p>
            <closer>Ihr <signed>Arthur</signed>
            </closer>
         </div>
      </body>
