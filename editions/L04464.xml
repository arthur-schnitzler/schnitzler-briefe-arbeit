         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0236"/>Herrn</addrLine>
               <addrLine>Guſtav Schwazkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">Wien I</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207301">
