         <div type="image">
            <p rend="center">
               <pb facs="HS00048772X_0235"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb45260">Insel Brioni i. d. Adria</rs>.</hi>
            </p>
            <p rend="center">
               <hi rend="pre-print">Im <rs type="place" ref="#pmb364047">Hafen</rs>.</hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="HS00048772X_0236"/>
               <salute>Herzliche Grüße.</salute> Wir
      ſind noch immer
      da. Es iſt ſo ſchön! –
      <date>Samſtag</date> Abreiſe in
              die <rs type="place" ref="#pmb40260">Bozner</rs> Gegend</p>
            <closer>Ihr <signed>Arthur</signed>
               <lb/>
               <handShift scribe="#pmb2173"/>Herzlichst <signed>Olga</signed>.</closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <anchor type="textConst" xml:id="T_L04464-1"/>
               <handShift scribe="#pmb25689"/>Beſte Grüße<lb/>
               <space unit="chars" quantity="1"/>
               <signed>Walther Gross</signed>
               <note type="textConst" corresp="T_L04464-1">Der Gruß von <rs type="person" ref="#pmb25689">Walter Gross</rs> steht entlang des linken Randes.</note>
            </p>
         </div>
         <div type="writingSession" n="3">
            <p>
               <pb facs="HS00048772X_0235"/>
               <handShift scribe="#pmb3227"/>Viele recht herzliche Grüße von Ihrer<lb/>
               <signed>Marta Stross-Karlweis</signed>
            </p>
         </div>
         <div type="writingSession" n="4">
            <p>Wa<c rendition="#gemination-n"/> sehe ich Sie lieber Freund endlich einmal in <rs type="place" ref="#pmb45260">Brioni</rs>.</p>
            <closer>Ihr <signed>LKupelwieser</signed>
            </closer>
         </div>
      </body>
