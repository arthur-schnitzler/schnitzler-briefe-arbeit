   <text>
      <body>
         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="MS-SCHNITZLER-B-0008-B-00001-000-00266" />
                  <rs type="place" ref="#pmb50">win</rs> fr <rs type="place" ref="#pmb34860">steindorfosziachersee</rs> 5 22 <date>4/7</date>
                  <space unit="chars" quantity="1" />
                  <time>3 45n</time> = </dateline>
            </opener>
            <p>schicken sye mir bitte sofort <anchor type="commentary" xml:id="K_L00812-1" />nummero
                  sechzehn<note type="commentary" corresp="K_L00812-1">Diese Nummer war am
                     <date>1. 7. 1898</date> erschienen.</note> der <rs ref="#pmb29749" type="org">wiener
                  rundschau</rs> von <anchor type="commentary" xml:id="K_L00812-2" />
               <date>ersten juny</date>
               <note type="commentary" corresp="K_L00812-2">Wie aus dem Brief vom <ref type="schnitzler-briefe" subtype="date-only" target="L00811" /> hervorgeht,
                  meinte er den <date>1. 7. 1898</date>.</note> bryef unterwegs herzlychst
                  <signed>rychard .+</signed>
            </p>
         </div>
      </body>
