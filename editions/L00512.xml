   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="1895_AS_RBH_3_00021"/>Herrn <hi rend="latintype">Dr. Richard
                     Beer-Hofmann</hi>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb50" type="place">Wien</rs>.</addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs ref="#pmb190427" type="place">I Wollzeile 15</rs>
                  </hi>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="1895_AS_RBH_3_00022"/>
               <salute>Lieber Richard,</salute> für den Fall, daß ich Sie
               früher nicht ſehe: den Sitz zu <anchor type="commentary" xml:id="K_L00512-1"/>
               <rs type="event" ref="#pmb42446" subtype="implied">
                  <rs ref="#pmb42444" type="work">Goldene Herzen</rs>
               </rs>
               <note type="commentary" corresp="K_L00512-1">
                  <ref type="schnitzler-kultur" target="pmb42446"/>.</note>
               erhalten Sie <date>Samſtag</date> zugeſandt. Auch <rs ref="#pmb42452" type="person">
                  <hi rend="latintype">Zelzer</hi>
               </rs> hab ich ſchon wegen des <anchor type="commentary" xml:id="K_L00512-2"/>
               <rs type="event" ref="#pmb42439" subtype="implied">
                  <rs ref="#pmb30455" type="work">Winkelglücks</rs>
               </rs>
               <note type="commentary" corresp="K_L00512-2">
                  <ref type="schnitzler-kultur" subtype="Cf" target="pmb42439"/>.</note> geſprochen.</p>
            <closer>Herzlich Ihr<lb/>
               <signed>Arthur</signed>
            </closer>
         </div>
      </body>
