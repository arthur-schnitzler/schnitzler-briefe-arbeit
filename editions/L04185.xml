   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="MS-SCHNITZLER-B-00096-B-000-00359"/>Arthur Schnitzler,</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb2318">Partenkirchen</rs></addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb808">Haus Tannenberg</rs></addrLine>
            </address>
            <address>
               <addrLine>Herrn Gustav Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">Wien I</rs></addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207301">Tiefer Graben 17</rs></addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="MS-SCHNITZLER-B-00096-B-000-00360"/>Am <rs type="place" ref="#pmb90567">Eibsee</rs>
                  <space unit="chars" quantity="1"/>
                  <date>10. 9. 1917</date>
               </dateline>
            </opener>
            <p>von einem ſchönen Ausflug ſenden wir Ihnen die herzlichſten Grüße.</p>
            <closer>Ihr<lb/>
               <signed>Arthur</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <closer>
               <handShift scribe="#pmb2173"/>Alles Herzliche, Ihre <signed>OlgaS.</signed>
            </closer>
         </div>
         <div type="writingSession" n="3">
            <p>
               <handShift scribe="#pmb2315"/>In aller Verehrung, die ehemals kleine</p>
            <closer>
               <signed>Lisl</signed>.</closer>
         </div>
         <div type="writingSession">
            <p>
               <salute>
                  <handShift scribe="#pmb21647"/>Sehr verehrter Herr Schwarzkopf,</salute> nach
               unendlich lange<add place="inline">r</add>
               <space unit="chars" quantity="1"/>
               <add place="above">Zeit</add> wieder einmal herzlichſte Grüße und beſte Empfehlungen.
               Wann wird man ſich wieder einmal ſehen?</p>
            <closer>Ihr <signed>
                  <subst>
                     <del rend="overwritten">Marx</del>
                     <add place="inline">Paul</add>
                  </subst>Marx</signed>
            </closer>
         </div>
      </body>
