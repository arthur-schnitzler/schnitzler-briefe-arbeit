   <text>
      <body>
         <div type="writingSession" n="1">
            <p>
               <pb facs="MS-SCHNITZLER-B-00043-B-00002-000-00131"/>
               <rs type="person" ref="#pmb18404" subtype="implied">Mamas</rs> Befinden wirklich
               verzweifelt bitte Sie innigst morgen <time>vormittag</time>
               <space unit="chars" quantity="1"/>
               <rs ref="#pmb192623" type="place">Salesianergasse</rs> kommen wo ich auch bin eventuelle
               Absage bitte depeschieren an <rs ref="#pmb24233" type="person">Schlesinger</rs>
               <space unit="chars" quantity="1"/>
               <rs ref="#pmb795" type="place">Elisabethstrasse 6</rs></p>
            <closer>
               <signed>Hugo</signed>
            </closer>
         </div>
      </body>
