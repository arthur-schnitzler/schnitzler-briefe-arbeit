   <text>
      <body>
         <div type="writingSession" n="1">
            <opener>
               <salute rend="center">
                  <pb facs="AS_Beer-Hofmann_Abschrift_00339" />Richard! Paula!</salute>
            </opener>
            <p>Wenn Ihr die <anchor type="commentary" xml:id="K_L00577-1" />Schlagobers<note type="commentary" corresp="K_L00577-1">österreichisch: Schlagsahne</note>-Torte
               allein auffresst, so seid Ihr ein nichtswürdiges Gesindel. Ich wünsch meinen Theil um
                  <time>¼ 9</time> als letzten Gang servirt zu erhalten, der nicht gestrichen werden
               kann. <signed>Arthur</signed>
            </p>
            <postscript>
               <dateline>(<rs type="place" ref="#pmb958">Skodsborg</rs>
                  <space unit="chars" quantity="1" />
                  <date>96</date>)</dateline>
            </postscript>
         </div>
      </body>
