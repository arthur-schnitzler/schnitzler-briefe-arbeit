            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="HS00048772X_0249"/>
               <rs type="place" ref="#pmb723">
                  <hi rend="pre-print">Hôtel und Pension Wildbad Waldbrunn b. Welsberg
                     (Pustertal)</hi>
               </rs>
            </p>
         </div>
         <div type="writingSession" n="1">
            <p>
               <pb facs="HS00048772X_0249"/>
               <anchor type="textConst" xml:id="T_L04471-1"/>
               <date>10. 8. 907</date>, noch i<c rendition="#gemination-m"/>er, <salute>lieber
                  Guſtav</salute> ſind<note type="textConst" corresp="T_L04471-1">entlang des linken
                  Randes geschrieben</note>
               <space unit="chars" quantity="1"/>
               <anchor type="textConst" xml:id="T_L04471-2"/>wir oben<note type="textConst" corresp="T_L04471-2">ab hier am rechten Rand</note>; ſeit 8 Tagen iſt <rs type="person" ref="#pmb12701" subtype="implied">Mama</rs> bei uns. Wir wollten
               vielleicht nach  <date>20.</date> ſüdwärts, <rs type="place" ref="#pmb43520">Meran</rs>, od <rs type="place" ref="#pmb465">Riva</rs>
            </p>
            <closer>herzlichſt<lb/>Ihr <signed>A.</signed>
               <lb/>
               <handShift scribe="#pmb2173"/>
               <anchor type="textConst" xml:id="T_L04471-3"/>Herzliche Grüsse! <signed>Olga</signed>
               <note type="textConst" corresp="T_L04471-3">
                  <rs type="person" ref="#pmb2173">Olga Schnitzlers</rs> Gruß steht am unteren Rand
                  unter dem Bild.</note>
            </closer>
         </div>
      </body>
