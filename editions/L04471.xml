      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0250"/>
                  <hi rend="pre-print">An</hi> Hrn Guſtav Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb51">Wien I</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb207296">I. Tiefer Graben 23</rs>
