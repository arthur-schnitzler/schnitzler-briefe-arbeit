   <text>
      <body>
         <div type="writingSession" n="1">
            <opener>
               <seg type="letterhead">
                  <seg rend="left">
                     <pb facs="Arthur-Schnitzler_an_Hermann-Bahr_00269"/>
                     <hi rend="pre-print">Dr. Arthur Schnitzler</hi>
                  </seg>
                  <seg rend="right">
                     <date>10. 4. 90<unclear>7</unclear>
                     </date>
                  </seg>
               </seg>
               <seg type="letterhead">
                  <hi rend="pre-print">
                     <rs ref="#pmb168940" type="place">Wien XVIII. Spoettelgasse 7</rs>.</hi>
               </seg>
            </opener>
            <p>
               <salute>lieber Hermann,</salute> ich ſtelle dir hiermit Herrn <rs ref="#pmb27665" type="person">Ernſt Goth</rs>
               <space unit="chars" quantity="1"/>
               <add place="above">vor</add>, jetzt beim <rs ref="#pmb29306" type="org">Peſter
                  Lloyd</rs>, mir ſeit Jahren perſönlich, dir wohl auch dem <pb facs="Arthur-Schnitzler_an_Hermann-Bahr_00268"/>Namen nach oder aus
               Feuilletons bekannt und bitte dich wenn möglich ein paar Minuten einer Angelegenheit
               zu widmen für die er dich intereſſiren möchte.</p>
            <closer>herzlichſt dein<lb/>
               <signed>A. S.</signed>
            </closer>
         </div>
      </body>
