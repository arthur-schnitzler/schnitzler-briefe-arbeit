               <note type="commentary" corresp="K_L02412-1">
                  <ref type="schnitzler-tagebuch" subtype="Cf" target="1905-03-14"/>.
               </note> besuchten!</p>
            <closer>Ihr <signed>Hugo</signed>
               <lb/>
               <signed>
                  <handShift scribe="#pmb3220"/>Christiane</signed>
               <lb/>
               <handShift scribe="#pmb2292"/>Herzlichst <signed>Gerty</signed>
            </closer>
         </div>
