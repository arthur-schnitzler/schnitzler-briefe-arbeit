         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="MS-SCHNITZLER-B-00096-B-000-00326"/>
                  <date>Montag</date>
               </dateline>
               <seg rend="right">
                  <time>abend</time>
               </seg>
               <salute>lieber Guſtav,</salute>
            </opener>
            <p>
               <anchor type="commentary" xml:id="K_L04170-1"/>morgen<note type="commentary" corresp="K_L04170-1">
                  <ref type="wienerschnitzler" target="1911-01-24" subtype="Cf"/>.</note>
               <space unit="chars" quantity="1"/>
               <time>11.20</time> fahren wir
               auf den <rs type="place" ref="#pmb189">Se<c rendition="#gemination-m"/>ering</rs> (<hi rend="latintype">
                  <rs type="place" ref="#pmb413">S. B. Hotel</rs>
               </hi>)
      denken <anchor type="commentary" xml:id="K_L04170-2"/>bis <date>Freitag</date>
               <note type="commentary" corresp="K_L04170-2">Tatsächlich fuhren sie
         am Freitag, dem <ref type="wienerschnitzler" subtype="date-only" target="1911-01-27"/> retour.</note> zu bleiben,
      wär ſehr ſchön, <anchor type="commentary" xml:id="K_L04170-3"/>we<c rendition="#gemination-n"/> Sie hinauf
               kämen<note type="commentary" corresp="K_L04170-3">
                  <rs type="person" ref="#pmb12740">Schwarzkopf</rs> kam nicht.</note>.</p>
            <closer>Herzlichſt<lb/> Ihr <signed>A.</signed>
            </closer>
         </div>
      </body>
