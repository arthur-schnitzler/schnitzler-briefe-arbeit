         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="HS00048772X_0145"/>
                  <date>Mittwoch Abend</date>.</dateline>
            </opener>
            <p>Adreſſe bleibt bis auf weiteres <hi rend="latintype">
                  <rs type="place" ref="#pmb36282">Pension Pundschu</rs>
               </hi>.</p>
            <p>– <date>
                  <anchor type="commentary" xml:id="K_L04420-1"/>Geſtern<note type="commentary" corresp="K_L04420-1">
                     <ref type="wienerschnitzler" subtype="Cf" target="1899-07-18"/>.</note> früh</date> hier angeko<c rendition="#gemination-m"/>en. – <anchor type="commentary" xml:id="K_L04420-2"/>
               <date>Geſtern</date>
               <space unit="chars" quantity="1"/>
               <date>Nachmittg</date>
               <note type="commentary" corresp="K_L04420-2">
                  <ref type="schnitzler-tagebuch" subtype="Cf" target="1899-07-18"/>.</note> und
                  <anchor type="commentary" xml:id="K_L04420-3"/>
               <date>heute</date> auf einer
               ſchönen Radpartie<note type="commentary" corresp="K_L04420-3">
                  <ref type="schnitzler-tagebuch" subtype="Cf" target="1899-07-19"/>.</note> mit <rs type="person" ref="#pmb14707 #pmb14711">Burger’s</rs>. – <anchor type="commentary" xml:id="K_L04420-4"/>
               <rs type="person" ref="#pmb10863">Richard</rs> arbeitet und wird erſt <date>So<c rendition="#gemination-n"/>tag</date>
               <note type="commentary" corresp="K_L04420-4">
                  <ref type="schnitzler-briefe" target="L00946" subtype="Cf"/>.</note> ſichtbar.</p>
            <closer>Herzlichſt Ihr <signed>A.</signed>
            </closer>
         </div>
