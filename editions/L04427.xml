                  <hi rend="capitals">
                     <rs type="place" ref="#pmb867">Innsbruck</rs> von Nord</hi>.</hi>
            </seg>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="HS00048772X_0159"/>
                  <date>12/7. 901</date>.</dateline>
            </opener>
            <p>Dank für den lieben <anchor type="commentary" xml:id="K_L04427-1"/>Brief<note type="commentary" corresp="K_L04427-1">
                  <ref type="schnitzler-briefe" target="L04308"/>.</note>.</p>
            <p>Reiſen eben nach <hi rend="latintype">
                  <rs type="place" ref="#pmb946">Vahrn</rs>
               </hi>,</p>
            <closer>herzlich<supplied>e</supplied> Grüße. <signed>A</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb2315"/>Servus,</p>
            <closer>
               <signed>Lisl</signed>
            </closer>
         </div>
         <div type="writingSession" n="3">
            <p>
               <handShift scribe="#pmb2173"/>Beſte Grüße!</p>
            <closer>
               <signed>Olga</signed>
            </closer>
            <postscript>
               <p>
                  <anchor type="textConst" xml:id="T_L04427-1"/>Wenn auch verdreht u. in den Wolken.<note type="textConst" corresp="T_L04427-1">Ihr Text ist oberhalb und verkehrt zum Bildmotiv geschrieben, so dass er über die abgebildeten Wolken läuft.</note>
               </p>
            </postscript>
         </div>
      </body>
