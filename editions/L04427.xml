         <div type="address">
            <address>
               <addrLine>
                  <pb facs="HS00048772X_0160"/>Herrn Guſtav Schwarzkopf</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb50">
                     <hi rend="latintype">Wien</hi>
                  </rs>
