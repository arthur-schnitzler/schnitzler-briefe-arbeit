   <text>
      <body>
         <div type="address">
            <address>
               <addrLine>
                  <pb facs="1897_AS_RBH_2_00062"></pb>Herrn Dr. <hi rend="latintype">Richard
                     Beer-Hofmann</hi>
               </addrLine>
               <addrLine>
                  <rs ref="#pmb30" type="place">
                     <hi rend="latintype">Salzburg</hi>
                  </rs>
               </addrLine>
               <addrLine>
                  <hi rend="latintype">
                     <rs ref="#pmb230" type="place">Hotel Oesterreichischer Hof</rs>.</hi>
               </addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="1897_AS_RBH_2_00064"></pb>
                  <date>Dinſtag</date>
               </dateline>
            </opener>
            <p>
               <salute>Lieber Richard.</salute>
               <space unit="chars" quantity="1"></space>
               <date>Do<c rendition="#gemination-n"></c>erſtag</date>
               <space unit="chars" quantity="1"></space>
               <date>Abend</date> oder <date>Freitg</date>
               <space unit="chars" quantity="1"></space>
               <date>früh</date> bin ich in <rs ref="#pmb213" type="place">Iſchl</rs>. Das Zi<c rendition="#gemination-m"></c>er für <rs ref="#pmb11485" type="person">Paul</rs> bei
                  <rs ref="#pmb22474" type="person">Petter</rs> beſtellt. Trifft Sie dieſer Brief
               überhaupt noch in <rs ref="#pmb30" type="place">Salzburg</rs>? –</p>
            <p>Grüßen Sie <rs ref="#pmb11485" type="person">Paul</rs> herzlich; auch ſich
               ſelbſt.</p>
            <closer>Ihr <signed>Arthur</signed>
            </closer>
         </div>
      </body>
