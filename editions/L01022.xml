      <body>
         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="MS-SCHNITZLER-B-00017-A-00001-000-00029"/>
                  <rs ref="#pmb1120" type="place">Hotel Krantz</rs>
                  <lb/>am Mehlmarkt <lb/>
                  <date>Sonntag</date>
               </dateline>
               <salute>Lieber Dr. Schnitzler</salute>
            </opener>
            <p>Warum sehe ich Sie denn gar nicht dies Mal<space unit="chars" quantity="1"/>
               <c rendition="#dots" n="2"/> Ich habe mich jeden Tag nach Ihnen gesehnt und sehe nur
               gleichgültige Gesichter.</p>
            <closer>Ihr<lb/>
               <signed>Georg Brandes</signed>
            </closer>
            <postscript>
               <p>Montag Abend?</p>
            </postscript>
         </div>
      </body>
