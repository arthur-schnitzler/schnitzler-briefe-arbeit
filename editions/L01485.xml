         <div type="writingSession" n="1">
            <p>
               <pb facs="Hs-30885,118_002"/>
               <salute>lieber Hugo,</salute> wir möchten Sie <anchor type="commentary" xml:id="K_L01485-1"/>
               <date>Montag</date>
               <note type="commentary" corresp="K_L01485-1">
                  <ref target="1905-01-02" type="schnitzler-tagebuch" subtype="See"/>. </note>
               <space unit="chars" quantity="1"/>
               <add place="below">den 2.</add>
               <space unit="chars" quantity="1"/>
               <time>Abend 8</time>
               <space unit="chars" quantity="1"/>
               <rs ref="#pmb63" type="place">Hietzing</rs>
               <space unit="chars" quantity="1"/>ſehen.</p>
            <p>Antwort <rs ref="#pmb50" type="place">Wien</rs> erbeten.</p>
            <closer>Ihr <signed>A.</signed>
            </closer>
            <postscript>
               <p>Ich <anchor type="commentary" xml:id="K_L01485-2"/>ſchreibe auch an <rs ref="#pmb10863" type="person">Richard</rs>
                  <note type="commentary" corresp="K_L01485-2">Das erlaubt, diese Karte vor jener an
                        <rs ref="#pmb10863" type="person">Beer-Hofmann</rs> vom gleichen Tag
                     anzusetzen.</note>.</p>
            </postscript>
         </div>
         <div type="writingSession" n="2">
            <closer>
               <signed>
                  <handShift scribe="#pmb2173"/>Olga.</signed>
            </closer>
         </div>
      </body>
