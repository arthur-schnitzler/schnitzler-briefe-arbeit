         <div type="writingSession" n="1">
            <opener>
               <dateline rend="right">
                  <pb facs="MS-SCHNITZLER-B-0008-B-00001-000-00313"></pb>
                  <date when="1899-09-07">7/IX 99</date>
               </dateline>
            </opener>
            <p>
               <salute>Lieber Arthur!</salute> Ich übersiedle, hoffentlich auf einige Wochen, nach
                  <hi n="1" rend="underline">
                  <rs ref="#pmb946" type="place">Vahrn</rs> bei <rs ref="#pmb43040" type="place">Brixen</rs>
               </hi>. Nähere Adresse nicht notwendig. Herzlichst <signed>Richard</signed>
            </p>
         </div>
