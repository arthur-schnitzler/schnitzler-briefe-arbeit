      <body>
         <div type="writingSession" n="1">
            <opener>
               <salute>
                  <pb facs="MS-SCHNITZLER-B-00096-B-000-00185"/>Lieber Freund,</salute>
            </opener>
            <p>hier iſt das <anchor type="commentary" xml:id="K_L04105-1"/>
               <rs type="work" ref="#pmb31975" subtype="implied">Mscr.</rs>
               <note type="commentary" corresp="K_L04105-1">Er dürfte ihm das Manuskript von <rs type="work" ref="#pmb31975">Die kleine Komödie</rs> übergeben haben, um ein kritisches
                  Urteil zu bekommen. <ref type="schnitzler-tagebuch" subtype="Cf" target="1894-10-10"/>
               </note> Um Nachſicht wird gebeten.</p>
            <closer>Herzlich der Ihre <signed>ArthSch</signed>
            </closer>
            <postscript>
               <dateline>
                  <date>3. 10. 94</date>.</dateline>
            </postscript>
         </div>
