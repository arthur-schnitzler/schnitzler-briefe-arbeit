         <div type="address">
            <address>
               <addrLine>
                  <pb facs="1910_AS_RBH_1_00015"/>Dr. Richard Beer-Hofmann</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb68">Wien XVIII</rs>
               </addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb235251">Hasenauerstr 59</rs>.</addrLine>
               <addrLine>
                  <rs type="place" ref="#pmb41240">Autriche</rs>
               </addrLine>
            </address>
         </div>
         <div type="image">
            <p rend="center">
               <pb facs="1910_AS_RBH_1_00014"/>
               <hi rend="pre-print">
                  <rs type="place" ref="#pmb562">Genève</rs>. – <rs type="place" ref="#pmb52085">Pont des Bergues</rs> et <rs type="place" ref="#pmb52087">Ile
                     Rousseau</rs>.</hi>
            </p>
         </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="1910_AS_RBH_1_00015"/>
                  <hi rend="latintype">
                     <rs type="place" ref="#pmb562">Genf</rs>
                  </hi>, <date>30. 5. 10</date>
               </dateline>
            </opener>
            <closer>Herzlichſte Grüße und auf baldgs Wiederſehen<lb/>Ihr <signed>Arthur</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <p>
               <handShift scribe="#pmb2173"/>Wenn einer eine Reise tut, so kann er was erzälen, und
               das werd ich, hoffentlich bald!</p>
            <closer>
               <signed>O.</signed>
            </closer>
         </div>
