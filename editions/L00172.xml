         <div type="writingSession" n="1">
            <opener>
               <salute>
                  <pb facs="1893_AS_RBH_1_00037"/>Lieber Richard,</salute>
            </opener>
            <p>ko<c rendition="#gemination-m"/>en Sie beſti<c rendition="#gemination-m"/>t <damage agent="paperloss">
                  <supplied>a</supplied>
               </damage>m <date>So<c rendition="#gemination-n"/>tag</date>
               <space unit="chars" quantity="1"/>
               <time>Nachmittg</time>
               <space unit="chars" quantity="1"/>
               <damage agent="paperloss">
                  <supplied>um</supplied>
               </damage>
               <space unit="chars" quantity="1"/>
               <time>5</time> zu mir, <rs ref="#pmb11740" type="person">
                  <hi rend="latintype">Loris</hi>
               </rs>
               <space unit="chars" quantity="1"/>
               <damage agent="paperloss">
                  <supplied>und</supplied>
               </damage>
               <space unit="chars" quantity="1"/>
               <rs ref="#pmb2167" type="person">
                  <hi rend="latintype">Salten</hi>
               </rs> ko<c rendition="#gemination-m"/>en auch <damage agent="paperloss">
                  <supplied>noc</supplied>
               </damage>
               <unclear>h</unclear>
               <space unit="chars" quantity="1"/>
               <rs ref="#pmb4326" type="person">
                  <hi rend="latintype">Ehrhard</hi>
               </rs>.</p>
            <closer>
               <signed>Arthur</signed>
            </closer>
         </div>
