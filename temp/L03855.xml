   <text>
      <body>
         <div type="writingSession" n="1">
            <opener>
               <seg type="letterhead">
                  <pb facs="MS-SCHNITZLER-B-00039-000-00095"/>
                  <hi rend="capitals">
                     <hi rend="pre-print">
                        <rs type="org" ref="">
                        Neue freie Presse</rs>.
                  </hi>
                  </hi>
               </seg>
               <seg type="letterhead">
                  <hi rend="capitals">
                     <hi rend="pre-print">Redaction:
                  </hi>
                  </hi>
               </seg>
               <seg type="letterhead">
                  <hi rend="capitals">
                     <rs type="place" ref="#pmb50">
                        <hi rend="pre-print">Wien
                     </hi>
                     </rs>
                  </hi>
               </seg>
               <seg type="letterhead">
                  <seg rend="left">
                     <hi rend="pre-print">
                        <rs type="place" ref="#pmb237534">Kolowratring, Fichtegasse Nr. 11</rs>.</hi>
                  </seg>
                  <seg rend="right">
                     <date>
               30 März 95
            </date>
                  </seg>
               </seg>
               <salute>Lieber Freund!</salute>
            </opener>
            <p>
               <date>Nachmittag</date>
               <date>zwischen 4 u. 6</date>
      komme ich zu Ihnen. </p>
            <p>Kann ich das nicht so
      telephonire ich Ihnen die
      Logennummer.</p>
            <p>Sollte von <rs type="person" ref="#pmb12331" subtype="implied">M. G.</rs> Brief
               über <rs type="work" ref="#pmb76499">d. G.</rs> da sein, so
      bitte ich mir ihn <hi rend="underline" n="1">nicht</hi>
      zu schicken, sondern ins
               <rs type="place" ref="#pmb14">Theater</rs> zu bringen
      </p>
            <closer>Herzlich Ihr<lb/>
               <signed>Th H.</signed>
            </closer>
         </div>
      </body>
