      <body>
         <div type="address">
            <pb facs="MS-SCHNITZLER-B-00096-B-000-00359"/> Cultivateur Gebuizler bautenkirchen Havi
            Turmenten Herrn Justar Schwarzkopf Wien I Diefer Graven 11 </div>
         <div type="writingSession" n="1">
            <opener>
               <dateline>
                  <pb facs="MS-SCHNITZLER-B-00096-B-000-00360"/>Am <rs type="place" ref="#pmb90567">Eibsee</rs>
                  <space unit="chars" quantity="1"/>
                  <date>10. 9. 1917</date>
               </dateline>
            </opener>
            <p> von einem ſchönen Ausflug ſenden wir Ihnen die herzlichſten Grüße. </p>
            <closer>Ihr<lb/>
               <signed>Arthur</signed>
            </closer>
         </div>
         <div type="writingSession" n="2">
            <closer>Alles Herzliche, Ihre <signed>OlgaS.</signed>
            </closer>
         </div>
         <div type="writingSession" n="3">
            <p>In aller Verehrung, die ehemals kleine</p>
            <closer>
               <signed>Lisl</signed>.</closer>
         </div>
         <div type="writingSession">
            <p>
               <salute>Sehr verehrter Herr Schwarzkopf,</salute> nach unendlich lange<add place="inline">r</add>
               <space unit="chars" quantity="1"/>
               <add place="above">Zeit</add> wieder einmal herzlichſte Grüße und beſte Empfehlungen. Wann wird man
               ſich wieder einmal ſehen?</p>
            <closer>Ihr <signed>PaulMarx</signed>
            </closer>
         </div>
      </body>
