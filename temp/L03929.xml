                  <hi rend="latintype">
                     <rs type="org" ref="">Duncker u Humblot</rs>
                  </hi> iſt</postscript>
               <postscript>ausgezeichnet. Wann ſoll das</postscript>
               <postscript>
                  <rs type="work" ref="">Buch</rs> heraus?</postscript>
            </page>
