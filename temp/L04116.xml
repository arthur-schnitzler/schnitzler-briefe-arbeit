         <div type="address">
            <address>
               <addrLine> <pb facs="MS-SCHNITZLER-B-00096-B-000-00209"/>
                  <rs type="place" ref="#pmb41240">Austria</rs></addrLine>
               <addrLine><rs type="place" ref="#pmb50"><hi rend="latintype">Wien</hi></rs></addrLine>
               <addrLine>Herrn <hi rend="latintype">Gustav Schwarzkopf</hi></addrLine>
               <addrLine><rs type="place" ref="#pmb50">Wien</rs></addrLine>
               <addrLine><rs type="place" ref="#pmb207296"><hi rend="latintype">I. Tiefer Graben&#160;23</hi></rs></addrLine>
            </address>
         </div>
         <div type="writingSession" n="1">
           <opener>
              <dateline rend="right">
                 <pb facs="MS-SCHNITZLER-B-00096-B-000-00210"/>an Bord der <rs type="org" ref="#pmb333759"><hi rend="latintype">Sig Jarl</hi></rs><space unit="chars" quantity="1"/>
               <date>17/7 9<unclear>6</unclear></date>
              </dateline>
           </opener>
            <p><salute>Lieber Freund,</salute> leſen Sie <hi rend="latintype">
                  <rs type="person" ref="">Lichtenbergs</rs>
               </hi><space unit="chars" quantity="1"/>
               <rs type="work" ref="">ausgew. Schriften</rs><space unit="chars" quantity="1"/><add place="below">(<rs type="org" ref="">U. Bibl.</rs>)</add> S. 229, Zeile 6 von
      
      unten u. f.&#160;–
      Da<c rendition="#gemination-n"/> leſen Sie <hi rend="latintype">Schwarzkopf</hi>,
               »<rs type="work" ref="#pmb299563">Recepte</rs>«, <rs type="work" ref="">Ein neues Geſetz</rs>. –
      da<c rendition="#gemination-n"/> ko<c rendition="#gemination-m"/>en Sie nach <hi rend="latintype">
         <rs type="place" ref="#pmb958">Skottsborg</rs>
               </hi>.</p>
            <p>Und außerdem laſſen Sie
      ſich herzlich grüßen!
      Nach dem <date>30.</date> treffen mich
      Nachrichten in <hi rend="latintype">
         <rs type="place" ref="#pmb36300">Kopenhagen</rs>
               </hi><space unit="chars" quantity="1"/>
               <hi rend="latintype">post rest</hi>. Aber beſſer iſt
      Sie ko<c rendition="#gemination-m"/>en ſelbſt.</p>
      <closer>Ihr<lb/> 
                  <signed>ArthSch</signed>
               </closer>
            
         </div>
      </body>
